+              content: markdown ? '# Test document\n' : '',
+              savedContent: markdown ? '# Test document\n' : '',
+              version: 'test-version-1',
+              size: markdown ? 16 : 0,
+              markdown,
+              viewMode: markdown ? 'preview' : 'source',
+              loaded: true,
+              loading: false,
+              saving: false,
+              issue: null,
+            }]
+          }
+          draft.activeId = id
+        })
+      },
+      deactivate: () => { state.update((draft) => { delete draft.activeId }) },
+      select: (id) => {
+        requireDocument(id)
+        state.update((draft) => { draft.activeId = id })
+      },
+      edit: (id, content) => {
+        requireDocument(id)
+        state.update((draft) => {
+          const document = draft.documents.find(candidate => candidate.id === id)
+          if (document !== undefined) document.content = content
+        })
+      },
+      setViewMode: (id, mode: WorkspaceFileViewMode) => {
+        requireDocument(id)
+        state.update((draft) => {
+          const document = draft.documents.find(candidate => candidate.id === id)
+          if (document !== undefined) document.viewMode = mode
+        })
+      },
+      reload: async (id) => {
+        const document = requireDocument(id)
+        this.calls.push({ method: 'files.reload', args: [id] })
+        const stub = this.stubs.get('files.reload')
+        if (stub !== undefined) await (stub(id) as Promise<void>)
+        else state.update((draft) => {
+          const current = draft.documents.find(candidate => candidate.id === document.id)
+          if (current !== undefined) {
+            current.content = current.savedContent
+            current.issue = null
+          }
+        })
+      },
+      save: async (id) => {
+        requireDocument(id)
+        this.calls.push({ method: 'files.save', args: [id] })
+        const stub = this.stubs.get('files.save')
+        if (stub !== undefined) await (stub(id) as Promise<void>)
+        else state.update((draft) => {
+          const document = draft.documents.find(candidate => candidate.id === id)
+          if (document !== undefined) document.savedContent = document.content
+        })
+      },
+      close: (id) => {
+        requireDocument(id)
+        state.update((draft) => {
+          const index = draft.documents.findIndex(candidate => candidate.id === id)
+          draft.documents = draft.documents.filter(candidate => candidate.id !== id)
+          if (draft.activeId !== id) return
+          const next = draft.documents[Math.min(index, draft.documents.length - 1)]
+          if (next === undefined) delete draft.activeId
+          else draft.activeId = next.id
+        })
+      },
+    }
