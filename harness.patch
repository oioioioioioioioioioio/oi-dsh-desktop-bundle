+/** Versioned text-document object layer behind the in-app file workbench. */
+
+import type { Context } from '@deepseek-ai/cordis'
+import type {
+  IApiClient, RpcError, WorkspaceDirectoryListing, WorkspaceId, WorkspaceTextFile,
+} from '@deepseek-ai/dsh-api-remotes/client'
+import type {
+  IWorkspaceFiles, WorkspaceFileDocument, WorkspaceFileIssue,
+  WorkspaceFilesState, WorkspaceFileViewMode,
+} from '../contract/workspaces.ts'
+import { createSnapshotStore, type SnapshotStore } from '../contract/store.ts'
+
+function fileId(workspaceId: WorkspaceId, path: string): string {
+  return `${String(workspaceId)}\u0000${path}`
+}
+
+function fileName(path: string): string {
+  const parts = path.split(/[/\\]/)
+  return parts.at(-1) || path
+}
+
+function isMarkdown(path: string): boolean {
+  return /\.(?:md|markdown)$/i.test(path)
+}
+
+function issueOf(error: RpcError): WorkspaceFileIssue {
+  return {
+    code: error.code,
+    message: error.message,
+    ...(error.code === 'workspace-file-not-readable' ? { reason: error.details.reason } : {}),
+  }
+}
+
+/** Client-owned open document set; wire content never enters a React store. */
+export class WorkspaceFilesRuntime implements IWorkspaceFiles {
+  readonly state: SnapshotStore<WorkspaceFilesState> = createSnapshotStore({ documents: [] })
+  private readonly loads = new Map<string, AbortController>()
+  private readonly saves = new Map<string, AbortController>()
+
+  /**
+   * @param ctx - client root context, used only to bind operation disposal.
+   * @param api - shared Workspace RPC client.
+   */
+  constructor(ctx: Context, private readonly api: IApiClient) {
+    ctx.effect(() => () => { this.dispose() }, 'runtime: Workspace file operations')
+  }
+
+  async listDirectory(
+    workspaceId: WorkspaceId,
+    path: string,
+    signal?: AbortSignal,
+  ): Promise<WorkspaceDirectoryListing> {
+    const response = await this.api.workspace.listDirectory({ workspaceId, path }, signal)
+    if (!response.result.ok) {
+      throw new Error(
+        `workspace directory listing failed: ${response.result.error.code}: ${response.result.error.message}`,
+      )
+    }
+    return response.result.value
+  }
+
+  async open(workspaceId: WorkspaceId, path: string): Promise<void> {
+    const id = fileId(workspaceId, path)
+    const existing = this.document(id)
+    if (existing !== undefined) {
+      this.state.update((draft) => { draft.activeId = id })
+      return
+    }
+    const markdown = isMarkdown(path)
+    this.state.update((draft) => {
+      draft.documents = [...draft.documents, {
+        id, workspaceId, path, name: fileName(path), content: '', savedContent: '',
+        markdown, viewMode: markdown ? 'preview' : 'source',
+        loaded: false, loading: false, saving: false, issue: null,
+      }]
+      draft.activeId = id
+    })
+    await this.reload(id)
+  }
+
+  deactivate(): void {
+    this.state.update((draft) => { delete draft.activeId })
+  }
+
+  select(id: string): void {
+    this.requireDocument(id)
+    this.state.update((draft) => { draft.activeId = id })
+  }
+
+  edit(id: string, content: string): void {
+    this.requireDocument(id)
+    this.state.update((draft) => {
+      const document = draft.documents.find(candidate => candidate.id === id)
+      if (document !== undefined) document.content = content
+    })
+  }
+
+  setViewMode(id: string, mode: WorkspaceFileViewMode): void {
+    this.requireDocument(id)
+    this.state.update((draft) => {
+      const document = draft.documents.find(candidate => candidate.id === id)
+      if (document !== undefined) document.viewMode = mode
+    })
+  }
+
+  async reload(id: string): Promise<void> {
+    const document = this.requireDocument(id)
+    this.loads.get(id)?.abort()
+    const abort = new AbortController()
+    this.loads.set(id, abort)
+    this.state.update((draft) => {
+      const current = draft.documents.find(candidate => candidate.id === id)
+      if (current !== undefined) {
+        current.loading = true
+        current.issue = null
+      }
+    })
+    try {
+      const response = await this.api.workspace.readFile({
+        workspaceId: document.workspaceId,
+        path: document.path,
+      }, abort.signal)
+      if (this.loads.get(id) !== abort || this.document(id) === undefined) return
+      if (!response.result.ok) {
+        this.failLoad(id, issueOf(response.result.error))
+        return
+      }
+      this.finishLoad(id, response.result.value)
+    } catch (error: unknown) {
+      if (this.loads.get(id) !== abort || abort.signal.aborted || this.document(id) === undefined) return
+      this.failLoad(id, { code: 'internal', message: error instanceof Error ? error.message : String(error) })
+    } finally {
+      if (this.loads.get(id) === abort) this.loads.delete(id)
+    }
+  }
+
+  async save(id: string): Promise<void> {
+    const document = this.requireDocument(id)
+    if (!document.loaded || document.version === undefined || document.loading || document.saving
+      || document.content === document.savedContent) return
+    const content = document.content
+    const version = document.version
+    const abort = new AbortController()
+    this.saves.set(id, abort)
+    this.state.update((draft) => {
+      const current = draft.documents.find(candidate => candidate.id === id)
+      if (current !== undefined) {
+        current.saving = true
+        current.issue = null
+      }
+    })
+    try {
+      const response = await this.api.workspace.writeFile({
+        workspaceId: document.workspaceId,
+        path: document.path,
+        content,
+        version,
+      }, abort.signal)
+      if (this.saves.get(id) !== abort || this.document(id) === undefined) return
+      if (!response.result.ok) {
+        this.failSave(id, issueOf(response.result.error))
+        return
+      }
+      const value = response.result.value
+      this.state.update((draft) => {
+        const current = draft.documents.find(candidate => candidate.id === id)
+        if (current === undefined) return
+        current.path = value.path
+        current.name = fileName(value.path)
+        current.version = value.version
+        current.size = value.size
+        current.savedContent = content
+        current.saving = false
+        current.issue = null
+      })
+    } catch (error: unknown) {
+      if (this.saves.get(id) !== abort || abort.signal.aborted || this.document(id) === undefined) return
+      this.failSave(id, { code: 'internal', message: error instanceof Error ? error.message : String(error) })
+    } finally {
+      if (this.saves.get(id) === abort) this.saves.delete(id)
+    }
+  }
+
+  close(id: string): void {
+    this.requireDocument(id)
+    this.loads.get(id)?.abort()
+    this.loads.delete(id)
+    this.saves.get(id)?.abort()
+    this.saves.delete(id)
+    this.state.update((draft) => {
+      const index = draft.documents.findIndex(candidate => candidate.id === id)
+      if (index < 0) return
+      draft.documents = draft.documents.filter(candidate => candidate.id !== id)
+      if (draft.activeId !== id) return
+      const next = draft.documents[Math.min(index, draft.documents.length - 1)]
+      if (next === undefined) delete draft.activeId
+      else draft.activeId = next.id
+    })
+  }
+
+  private finishLoad(id: string, value: WorkspaceTextFile): void {
+    this.state.update((draft) => {
+      const document = draft.documents.find(candidate => candidate.id === id)
+      if (document === undefined) return
+      document.path = value.path
+      document.name = fileName(value.path)
+      document.content = value.content
+      document.savedContent = value.content
+      document.version = value.version
+      document.size = value.size
+      document.markdown = isMarkdown(value.path)
+      document.viewMode = document.markdown ? document.viewMode : 'source'
+      document.loaded = true
+      document.loading = false
+      document.issue = null
+    })
+  }
+
+  private failLoad(id: string, issue: WorkspaceFileIssue): void {
+    this.state.update((draft) => {
+      const document = draft.documents.find(candidate => candidate.id === id)
+      if (document !== undefined) {
+        document.loading = false
+        document.issue = issue
+      }
+    })
+  }
+
+  private failSave(id: string, issue: WorkspaceFileIssue): void {
+    this.state.update((draft) => {
+      const document = draft.documents.find(candidate => candidate.id === id)
+      if (document !== undefined) {
+        document.saving = false
+        document.issue = issue
+      }
+    })
+  }
+
+  private document(id: string): WorkspaceFileDocument | undefined {
+    return this.state.getSnapshot().documents.find(document => document.id === id)
+  }
+
+  private requireDocument(id: string): WorkspaceFileDocument {
+    const document = this.document(id)
+    if (document === undefined) throw new Error(`workspace files: unknown document ${JSON.stringify(id)}`)
+    return document
+  }
+
+  private dispose(): void {
+    for (const operation of [...this.loads.values(), ...this.saves.values()]) operation.abort()
+    this.loads.clear()
+    this.saves.clear()
+  }
+}
