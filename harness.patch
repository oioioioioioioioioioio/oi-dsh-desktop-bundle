+import { useEffect, useState } from 'react'
+import type { ReactNode } from 'react'
+import { Copy, Minus, Square, X } from 'lucide-react'
+import css from './DesktopChrome.module.css'
+
+/** Native state required by the shell-owned Electron title bar. */
+export interface DesktopWindowState {
+  readonly maximized: boolean
+  readonly fullScreen: boolean
+}
+
+/** Structural subset of the preload bridge consumed by the Web shell. */
+export interface DesktopWindowControls {
+  getState(): Promise<DesktopWindowState>
+  minimize(): void
+  toggleMaximize(): void
+  close(): void
+  onStateChange(listener: (state: DesktopWindowState) => void): () => void
+}
+
+/** Optional desktop chrome around the browser shell content. */
+export interface DesktopChromeProps {
+  readonly title: string
+  readonly children: ReactNode
+  readonly controls?: DesktopWindowControls
+}
+
+interface DesktopGlobal {
+  readonly dshDesktop?: {
+    readonly windowControls?: DesktopWindowControls
+  }
+}
+
+const RESTORED_STATE: DesktopWindowState = { maximized: false, fullScreen: false }
+
+function globalWindowControls(): DesktopWindowControls | undefined {
+  return (globalThis as unknown as DesktopGlobal).dshDesktop?.windowControls
+}
+
+function DesktopFrame(props: Required<DesktopChromeProps>) {
+  const { controls } = props
+  const [windowState, setWindowState] = useState<DesktopWindowState>(RESTORED_STATE)
+
+  useEffect(() => {
+    let disposed = false
+    let receivedLiveState = false
+    const unsubscribe = controls.onStateChange((state) => {
+      receivedLiveState = true
+      if (!disposed) setWindowState(state)
+    })
+    void controls.getState().then(
+      (state) => {
+        if (!disposed && !receivedLiveState) setWindowState(state)
+      },
+      /* v8 ignore next -- IPC can reject only while Electron is tearing down this renderer. */
+      () => {},
+    )
+    return () => {
+      disposed = true
+      unsubscribe()
+    }
+  }, [controls])
+
+  const maximizeLabel = windowState.maximized ? '还原' : '最大化'
+
+  return (
+    <div className={css.chrome} data-maximized={windowState.maximized || undefined}>
+      {!windowState.fullScreen && (
+        <header className={css.titleBar} aria-label="窗口标题栏">
+          <div className={css.identity}>
+            <img className={css.logo} src="/logo.jpg" alt="" draggable={false} />
+            <span className={css.title}>{props.title}</span>
+          </div>
+          <div className={css.controls}>
+            <button className={css.control} type="button" aria-label="最小化" title="最小化" onClick={() => { controls.minimize() }}>
+              <Minus size={16} strokeWidth={1.5} aria-hidden="true" />
+            </button>
+            <button
+              className={css.control}
+              type="button"
+              aria-label={maximizeLabel}
+              title={maximizeLabel}
+              onClick={() => { controls.toggleMaximize() }}
+            >
+              {windowState.maximized
+                ? <Copy className={css.restoreIcon} size={14} strokeWidth={1.5} aria-hidden="true" />
+                : <Square size={13} strokeWidth={1.5} aria-hidden="true" />}
+            </button>
+            <button className={`${css.control} ${css.close}`} type="button" aria-label="关闭" title="关闭" onClick={() => { controls.close() }}>
+              <X size={17} strokeWidth={1.5} aria-hidden="true" />
+            </button>
+          </div>
+        </header>
+      )}
+      <div className={css.content}>{props.children}</div>
+    </div>
+  )
+}
+
+/** Render native-equivalent window chrome only when the Electron preload is present. */
+export function DesktopChrome(props: DesktopChromeProps) {
+  const controls = props.controls ?? globalWindowControls()
+  if (controls === undefined) return <>{props.children}</>
+  return <DesktopFrame {...props} controls={controls} />
+}
