@@ -0,0 +1,43 @@
+/** Sandboxed preload exposing only the typed DeepSeek Harness desktop bridge. */
+
+import { contextBridge, ipcRenderer } from 'electron'
+import type {
+  DesktopRequest, DesktopResponse, DesktopStreamMessage, DesktopWindowState, DshDesktopBridge,
+} from '@deepseek-ai/dsh-client-connection'
+import { DESKTOP_CHANNELS } from './channels.ts'
+
+const bridge: DshDesktopBridge = {
+  windowControls: {
+    getState: () => ipcRenderer.invoke(DESKTOP_CHANNELS.windowState) as Promise<DesktopWindowState>,
+    minimize: () => { ipcRenderer.send(DESKTOP_CHANNELS.windowMinimize) },
+    toggleMaximize: () => { ipcRenderer.send(DESKTOP_CHANNELS.windowToggleMaximize) },
+    close: () => { ipcRenderer.send(DESKTOP_CHANNELS.windowClose) },
+    onStateChange(listener: (state: DesktopWindowState) => void): () => void {
+      const receive = (_event: Electron.IpcRendererEvent, state: DesktopWindowState): void => {
+        listener(state)
+      }
+      ipcRenderer.on(DESKTOP_CHANNELS.windowState, receive)
+      return () => { ipcRenderer.removeListener(DESKTOP_CHANNELS.windowState, receive) }
+    },
+  },
+  writeClipboard: (text: string) =>
+    ipcRenderer.invoke(DESKTOP_CHANNELS.clipboardWrite, text) as Promise<void>,
+  boot: () => ipcRenderer.invoke(DESKTOP_CHANNELS.boot) as Promise<unknown>,
+  request: (id: string, request: DesktopRequest) =>
+    ipcRenderer.invoke(DESKTOP_CHANNELS.request, id, request) as Promise<DesktopResponse>,
+  cancelRequest: (id: string) => { ipcRenderer.send(DESKTOP_CHANNELS.cancelRequest, id) },
+  openStream: (id: string, kind: 'mux' | 'host') =>
+    ipcRenderer.invoke(DESKTOP_CHANNELS.openStream, id, kind) as Promise<void>,
+  closeStream: (id: string) => { ipcRenderer.send(DESKTOP_CHANNELS.closeStream, id) },
+  onStreamMessage(listener: (message: DesktopStreamMessage) => void): () => void {
+    const receive = (_event: Electron.IpcRendererEvent, message: DesktopStreamMessage): void => {
+      listener(message)
+    }
+    ipcRenderer.on(DESKTOP_CHANNELS.streamMessage, receive)
+    return () => { ipcRenderer.removeListener(DESKTOP_CHANNELS.streamMessage, receive) }
+  },
+  exportSession: (sessionId: string) =>
+    ipcRenderer.invoke(DESKTOP_CHANNELS.exportSession, sessionId) as Promise<{ canceled: boolean }>,
+}
+
+contextBridge.exposeInMainWorld('dshDesktop', bridge)
