+import { Context } from '@deepseek-ai/cordis'
+import { describe, expect, it } from 'vitest'
+import { LocalSandboxProvider } from '@deepseek-ai/dsh-sandbox-local'
+
+const READ_ONLY = { mode: 'read-only', workspaceRoot: 'C:\\workspace' } as const
+
+async function harness(internals: LocalSandboxProvider['internals']): Promise<{
+  ctx: Context
+  sandbox: LocalSandboxProvider
+}> {
+  const ctx = new Context()
+  await ctx.plugin(LocalSandboxProvider, {})
+  const sandbox = ctx.sandbox as LocalSandboxProvider
+  sandbox.internals = internals
+  return { ctx, sandbox }
+}
+
+describe('Electron Windows ACL runner environment', () => {
+  it('adds Node child mode only to an ACL runner launched through Electron', async () => {
+    const electron = await harness({
+      chain: ['windows-acl'],
+      windowsAclRunnerArgs: ['electron', 'runner.js'],
+      electronRuntime: true,
+    })
+    expect(electron.sandbox.confine(['pwsh'], READ_ONLY).env)
+      .toEqual({ ELECTRON_RUN_AS_NODE: '1' })
+    await electron.ctx.fiber.dispose()
+
+    const node = await harness({
+      chain: ['windows-acl'],
+      windowsAclRunnerArgs: ['node', 'runner.js'],
+      electronRuntime: false,
+    })
+    expect(node.sandbox.confine(['pwsh'], READ_ONLY).env).toBeUndefined()
+    await node.ctx.fiber.dispose()
+  })
+
+  it('passes Node child mode to the ACL functional probe', async () => {
+    const code = 'process.exit(process.env.ELECTRON_RUN_AS_NODE === "1" ? 0 : 1)'
+    const h = await harness({
+      chain: ['windows-acl', 'bwrap'],
+      windowsAclRunnerArgs: [process.execPath, '-e', code, '--'],
+      electronRuntime: true,
+      probeBwrap: () => false,
+    })
+    expect(h.sandbox.confine(['pwsh'], READ_ONLY).argv[0]).toBe(process.execPath)
+    await h.ctx.fiber.dispose()
+  })
+})
diff --git a/apps/electron/tests/ipc.spec.ts b/apps/electron/tests/ipc.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6e9a6c2fd1238c1fec0d0a41039abc7a2d676484
--- /dev/null
+++ b/apps/electron/tests/ipc.spec.ts
@@ -0,0 +1,281 @@
+import { describe, expect, it, vi } from 'vitest'
+import { RpcId } from '@deepseek-ai/dsh-host-apiproxy/api'
+import { DESKTOP_CHANNELS } from '../src/channels.ts'
+import { DesktopIpcController, parseDesktopRequest } from '../src/ipc.ts'
+
+type Handler = (event: unknown, ...args: unknown[]) => unknown
+type Listener = (event: unknown, ...args: unknown[]) => void
+
+class FakeIpc {
+  readonly handlers = new Map<string, Handler>()
+  readonly listeners = new Map<string, Listener>()
+
+  handle(channel: string, handler: Handler): void {
+    this.handlers.set(channel, handler)
+  }
+
+  on(channel: string, listener: Listener): void {
+    this.listeners.set(channel, listener)
+  }
+
+  removeHandler(channel: string): void {
+    this.handlers.delete(channel)
+  }
+
+  removeListener(channel: string, listener: Listener): void {
+    if (this.listeners.get(channel) === listener) this.listeners.delete(channel)
+  }
+
+  invoke(channel: string, event: unknown, ...args: unknown[]): unknown {
+    const handler = this.handlers.get(channel)
+    if (handler === undefined) throw new Error(`missing handler ${channel}`)
+    return handler(event, ...args)
+  }
+
+  emit(channel: string, event: unknown, ...args: unknown[]): void {
+    this.listeners.get(channel)?.(event, ...args)
+  }
+}
+
+function harness(options: {
+  fetch?: (request: Request) => Promise<Response>
+  host?: (signal: AbortSignal) => AsyncIterable<unknown>
+  exportSession?: (sessionId: unknown, signal: AbortSignal) => Promise<{ canceled: boolean }>
+  writeClipboard?: (text: string) => void
+} = {}) {
+  const ipc = new FakeIpc()
+  const messages: unknown[] = []
+  const sent: Array<{ channel: string; message: unknown }> = []
+  const frame = { url: 'dsh://app/' }
+  const contents = {
+    mainFrame: frame,
+    isDestroyed: () => false,
+    send: (channel: string, message: unknown) => {
+      sent.push({ channel, message })
+      if (channel === DESKTOP_CHANNELS.streamMessage) messages.push(message)
+    },
+  }
+  const windowListeners = new Map<string, Set<() => void>>()
+  let maximized = false
+  let fullScreen = false
+  const emitWindow = (name: string): void => {
+    for (const listener of windowListeners.get(name) ?? []) listener()
+  }
+  const window = {
+    webContents: contents,
+    on: (name: string, listener: () => void) => {
+      const listeners = windowListeners.get(name) ?? new Set<() => void>()
+      listeners.add(listener)
+      windowListeners.set(name, listeners)
+    },
+    removeListener: (name: string, listener: () => void) => {
+      const listeners = windowListeners.get(name)
+      listeners?.delete(listener)
+      if (listeners?.size === 0) windowListeners.delete(name)
+    },
+    isMaximized: () => maximized,
+    isFullScreen: () => fullScreen,
+    minimize: vi.fn(),
+    maximize: vi.fn(() => { maximized = true; emitWindow('maximize') }),
+    unmaximize: vi.fn(() => { maximized = false; emitWindow('unmaximize') }),
+    close: vi.fn(),
+  }
+  const event = { sender: contents, senderFrame: frame }
+  const fetcher = options.fetch ?? (async () => new Response('ok', { status: 201, headers: { 'x-desktop': 'yes' } }))
+  const host = options.host ?? (async function *() {})
+  const api = {
+    events: {
+      host: (_request: unknown, signal: AbortSignal) => host(signal),
+      mux: async function *() {},
+    },
+  }
+  const exportSession = options.exportSession ?? (async () => ({ canceled: false }))
+  const writeClipboard = options.writeClipboard ?? vi.fn()
+  const controller = new DesktopIpcController(
+    ipc as never,
+    window as never,
+    { fetch: fetcher } as never,
+    api as never,
+    { graph: () => ({ entries: [{ id: 'client' }] }) } as never,
+    exportSession,
+    writeClipboard,
+  )
+  return {
+    controller, event, frame, contents, ipc, messages, sent, window, windowListeners, writeClipboard,
+    setFullScreen(value: boolean) {
+      fullScreen = value
+      emitWindow(value ? 'enter-full-screen' : 'leave-full-screen')
+    },
+  }
+}
+
+describe('desktop IPC controller', () => {
+  it('returns the boot graph and dispatches sanitized process-local requests', async () => {
+    let received: Request | undefined
+    const h = harness({ fetch: async (request) => {
+      received = request
+      return new Response('result', { status: 202, headers: { 'x-result': 'yes' } })
+    } })
+    expect(h.ipc.invoke(DESKTOP_CHANNELS.boot, h.event)).toEqual({ entries: [{ id: 'client' }] })
+    await expect(h.ipc.invoke(DESKTOP_CHANNELS.request, h.event, 'request-1', {
+      path: '/api/session.list?archived=true',
+      method: 'POST',
+      headers: [['host', 'evil.example'], ['origin', 'https://evil.example'], ['content-type', 'application/json']],
+      body: '{}',
+    })).resolves.toEqual({
+      status: 202,
+      headers: [['content-type', 'text/plain;charset=UTF-8'], ['x-result', 'yes']],
+      body: 'result',
+    })
+    expect(received?.url).toBe('http://dsh.internal/api/session.list?archived=true')
+    expect(received?.headers.get('host')).toBe('127.0.0.1')
+    expect(received?.headers.has('origin')).toBe(false)
+    expect(await received?.text()).toBe('{}')
+    await h.controller.dispose()
+  })
+
+  it('rejects untrusted frames and malformed IPC records', async () => {
+    const h = harness()
+    const subframe = { url: 'dsh://app/' }
+    expect(() => h.ipc.invoke(DESKTOP_CHANNELS.boot, { sender: h.contents, senderFrame: subframe }))
+      .toThrow('rejected an untrusted sender')
+    expect(() => h.ipc.invoke(DESKTOP_CHANNELS.boot, { sender: {}, senderFrame: h.frame }))
+      .toThrow('rejected an untrusted sender')
+    await expect(h.ipc.invoke(DESKTOP_CHANNELS.request, h.event, '', {
+      path: '/api/x', method: 'GET', headers: [],
+    })).rejects.toThrow('id must be a non-empty bounded string')
+    expect(() => parseDesktopRequest({ path: '//outside', method: 'GET', headers: [] }))
+      .toThrow('absolute internal path')
+    expect(() => parseDesktopRequest({ path: '/api/x#fragment', method: 'GET', headers: [] }))
+      .toThrow('without a fragment')
+    expect(() => parseDesktopRequest({ path: '/api/x', method: 'DELETE', headers: [] }))
+      .toThrow('method must be GET, HEAD, or POST')
+    await h.controller.dispose()
+  })
+
+  it('controls only its trusted native window and publishes maximize and fullscreen state', async () => {
+    const h = harness()
+    expect(h.ipc.invoke(DESKTOP_CHANNELS.windowState, h.event)).toEqual({
+      maximized: false,
+      fullScreen: false,
+    })
+    expect(() => h.ipc.invoke(DESKTOP_CHANNELS.windowState, { sender: {}, senderFrame: h.frame }))
+      .toThrow('rejected an untrusted sender')
+
+    h.ipc.emit(DESKTOP_CHANNELS.windowMinimize, { sender: {}, senderFrame: h.frame })
+    expect(h.window.minimize).not.toHaveBeenCalled()
+    h.ipc.emit(DESKTOP_CHANNELS.windowMinimize, h.event)
+    expect(h.window.minimize).toHaveBeenCalledOnce()
+
+    h.ipc.emit(DESKTOP_CHANNELS.windowToggleMaximize, h.event)
+    expect(h.window.maximize).toHaveBeenCalledOnce()
+    expect(h.sent.at(-1)).toEqual({
+      channel: DESKTOP_CHANNELS.windowState,
+      message: { maximized: true, fullScreen: false },
+    })
+    h.ipc.emit(DESKTOP_CHANNELS.windowToggleMaximize, h.event)
+    expect(h.window.unmaximize).toHaveBeenCalledOnce()
+
+    h.setFullScreen(true)
+    expect(h.sent.at(-1)).toEqual({
+      channel: DESKTOP_CHANNELS.windowState,
+      message: { maximized: false, fullScreen: true },
+    })
+    h.ipc.emit(DESKTOP_CHANNELS.windowClose, h.event)
+    expect(h.window.close).toHaveBeenCalledOnce()
+
+    await h.controller.dispose()
+    expect(h.windowListeners.size).toBe(0)
+  })
+
+  it('writes exact text to the native clipboard only for its trusted renderer', async () => {
+    const writeClipboard = vi.fn()
+    const h = harness({ writeClipboard })
+
+    expect(h.ipc.invoke(DESKTOP_CHANNELS.clipboardWrite, h.event, 'exact\r\ntext')).toBeUndefined()
+    expect(writeClipboard).toHaveBeenCalledWith('exact\r\ntext')
+    expect(() => h.ipc.invoke(
+      DESKTOP_CHANNELS.clipboardWrite, { sender: {}, senderFrame: h.frame }, 'blocked',
+    )).toThrow('rejected an untrusted sender')
+    expect(() => h.ipc.invoke(DESKTOP_CHANNELS.clipboardWrite, h.event, 42))
+      .toThrow('desktop clipboard text must be a string')
+    expect(writeClipboard).toHaveBeenCalledTimes(1)
+
+    await h.controller.dispose()
+    expect(h.ipc.handlers.has(DESKTOP_CHANNELS.clipboardWrite)).toBe(false)
+  })
+
+  it('cancels unary requests and emits stream open, frame, and end messages', async () => {
+    let requestSignal: AbortSignal | undefined
+    const fetch = (request: Request): Promise<Response> => {
+      requestSignal = request.signal
+      return new Promise((_resolve, reject) => {
+        request.signal.addEventListener('abort', () => {
+          reject(new Error('request aborted', { cause: request.signal.reason }))
+        }, { once: true })
+      })
+    }
+    const h = harness({
+      fetch,
+      host: async function *() {
+        yield {
+          rpcId: RpcId('host-frame'),
+          payload: { type: 'host/session-removed', sessionId: 'session-1' },
+        }
+      },
+    })
+    const pending = h.ipc.invoke(DESKTOP_CHANNELS.request, h.event, 'request-1', {
+      path: '/api/session.list', method: 'GET', headers: [],
+    }) as Promise<unknown>
+    h.ipc.emit(DESKTOP_CHANNELS.cancelRequest, h.event, 'request-1')
+    await expect(pending).rejects.toBeDefined()
+    expect(requestSignal?.aborted).toBe(true)
+
+    expect(h.ipc.invoke(DESKTOP_CHANNELS.openStream, h.event, 'stream-1', 'host')).toBeUndefined()
+    await vi.waitFor(() => {
+      expect(h.messages).toEqual([
+        { id: 'stream-1', type: 'open' },
+        {
+          id: 'stream-1',
+          type: 'frame',
+          frame: {
+            type: 'server-request',
+            rpcId: 'host-frame',
+            method: 'host/session-removed',
+            payload: { type: 'host/session-removed', sessionId: 'session-1' },
+          },
+        },
+        { id: 'stream-1', type: 'end' },
+      ])
+    })
+    await h.controller.dispose()
+  })
+
+  it('removes handlers before aborting and awaits active stream and export operations', async () => {
+    let streamAborted = false
+    let exportAborted = false
+    const h = harness({
+      host: signal => ({
+        async *[Symbol.asyncIterator]() {
+          await new Promise<void>((resolve) => {
+            signal.addEventListener('abort', () => { streamAborted = true; resolve() }, { once: true })
+          })
+        },
+      }),
+      exportSession: async (_id, signal) => {
+        await new Promise<void>((resolve) => {
+          signal.addEventListener('abort', () => { exportAborted = true; resolve() }, { once: true })
+        })
+        return { canceled: true }
+      },
+    })
+    h.ipc.invoke(DESKTOP_CHANNELS.openStream, h.event, 'stream-1', 'host')
+    const exported = h.ipc.invoke(DESKTOP_CHANNELS.exportSession, h.event, 'session-1') as Promise<unknown>
+    await h.controller.dispose()
+    expect(streamAborted).toBe(true)
+    expect(exportAborted).toBe(true)
+    await expect(exported).resolves.toEqual({ canceled: true })
+    expect(h.ipc.handlers.size).toBe(0)
+    expect(h.ipc.listeners.size).toBe(0)
+  })
+})
diff --git a/apps/electron/tests/protocol.spec.ts b/apps/electron/tests/protocol.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c2236fa48e50a72f1869f4e42b2c5d3c0a899b25
--- /dev/null
+++ b/apps/electron/tests/protocol.spec.ts
@@ -0,0 +1,90 @@
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+import { createDesktopProtocolHandler } from '../src/protocol.ts'
+
+const roots: string[] = []
+
+afterEach(() => {
+  for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true })
+})
+
+function fixture(): {
+  handle: ReturnType<typeof createDesktopProtocolHandler>
+  plugin: string
+} {
+  const root = mkdtempSync(join(tmpdir(), 'dsh-electron-protocol-'))
+  roots.push(root)
+  const dist = join(root, 'dist')
+  mkdirSync(join(dist, 'assets'), { recursive: true })
+  const index = join(dist, 'index.html')
+  const plugin = join(root, 'plugin.js')
+  writeFileSync(index, '<!doctype html><main>desktop</main>')
+  writeFileSync(join(dist, 'assets', 'shell.js'), 'export const shell = true')
+  writeFileSync(join(dist, 'logo.jpg'), new Uint8Array([0xff, 0xd8, 0xff, 0xd9]))
+  writeFileSync(plugin, 'export const plugin = true')
+  return {
+    plugin,
+    handle: createDesktopProtocolHandler({
+      distIndex: index,
+      clientModules: { clientPath: id => id === '@scope/plugin' ? plugin : undefined },
+    }),
+  }
+}
+
+describe('desktop protocol', () => {
+  it('serves the shell, assets, and exact registered plugin bundles', async () => {
+    const { handle } = fixture()
+    const index = await handle(new Request('dsh://app/'))
+    expect(index.status).toBe(200)
+    expect(await index.text()).toContain('desktop')
+    const csp = index.headers.get('content-security-policy')
+    expect(csp).toContain("default-src 'self'")
+    expect(csp).toContain("script-src 'self' 'unsafe-eval'")
+    expect(csp).toContain("object-src 'none'")
+
+    const asset = await handle(new Request('dsh://app/assets/shell.js'))
+    expect(asset.status).toBe(200)
+    expect(asset.headers.get('content-type')).toContain('text/javascript')
+
+    const logo = await handle(new Request('dsh://app/logo.jpg'))
+    expect(logo.status).toBe(200)
+    expect(logo.headers.get('content-type')).toBe('image/jpeg')
+
+    const plugin = await handle(new Request('dsh://app/plugins/%40scope%2Fplugin/client.js'))
+    expect(plugin.status).toBe(200)
+    expect(await plugin.text()).toContain('plugin = true')
+    expect(plugin.headers.get('cache-control')).toBe('no-cache, no-store')
+  })
+
+  it('uses SPA fallback only for extensionless application routes', async () => {
+    const { handle, plugin } = fixture()
+    const route = await handle(new Request('dsh://app/sessions/current'))
+    expect(route.status).toBe(200)
+    expect(await route.text()).toContain('desktop')
+
+    expect((await handle(new Request('dsh://app/assets/missing.js'))).status).toBe(404)
+    expect((await handle(new Request('dsh://app/plugins/unknown/client.js'))).status).toBe(404)
+    rmSync(plugin)
+    expect((await handle(new Request('dsh://app/plugins/%40scope%2Fplugin/client.js'))).status).toBe(404)
+  })
+
+  it('rejects foreign authorities, traversal, malformed escapes, and non-read methods', async () => {
+    const { handle } = fixture()
+    expect((await handle(new Request('dsh://other/'))).status).toBe(404)
+    expect((await handle(new Request('dsh://app/%E0%A4%A'))).status).toBe(400)
+    expect((await handle(new Request('dsh://app/..%2Foutside'))).status).toBe(403)
+    const post = await handle(new Request('dsh://app/', { method: 'POST' }))
+    expect(post.status).toBe(405)
+    expect(post.headers.get('allow')).toBe('GET, HEAD')
+  })
+
+  it('returns headers without bodies for HEAD requests', async () => {
+    const { handle } = fixture()
+    const response = await handle(new Request('dsh://app/assets/shell.js', { method: 'HEAD' }))
+    expect(response.status).toBe(200)
+    expect(await response.text()).toBe('')
+    expect(response.headers.get('content-type')).toContain('text/javascript')
+  })
+})
diff --git a/apps/electron/tests/session-export.spec.ts b/apps/electron/tests/session-export.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3d92922039aaf5a86eb1c0b1b42dab68db5cfc8d
--- /dev/null
+++ b/apps/electron/tests/session-export.spec.ts
@@ -0,0 +1,93 @@
+import { mkdtempSync, readFileSync, readdirSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+vi.mock('electron', () => ({ dialog: { showSaveDialog: vi.fn() } }))
+
+import { dialog } from 'electron'
+import { exportSessionToFile, sessionLogZipFilename, writeResponseAtomically } from '../src/session-export.ts'
+
+const roots: string[] = []
+
+afterEach(() => {
+  vi.mocked(dialog).showSaveDialog.mockReset()
+  for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true })
+})
+
+function tempRoot(): string {
+  const root = mkdtempSync(join(tmpdir(), 'dsh-electron-export-'))
+  roots.push(root)
+  return root
+}
+
+describe('desktop session export', () => {
+  it('publishes a streamed response through a random sibling temporary file', async () => {
+    const root = tempRoot()
+    const target = join(root, 'session.zip')
+    await writeResponseAtomically(target, new Response(new Uint8Array([1, 2, 3, 4])), new AbortController().signal)
+    expect([...readFileSync(target)]).toEqual([1, 2, 3, 4])
+    expect(readdirSync(root)).toEqual(['session.zip'])
+  })
+
+  it('keeps an existing target and removes the temporary file when streaming aborts', async () => {
+    const root = tempRoot()
+    const target = join(root, 'session.zip')
+    writeFileSync(target, 'existing')
+    const abort = new AbortController()
+    const body = new ReadableStream<Uint8Array>({
+      start(controller) {
+        controller.enqueue(new Uint8Array([1]))
+        abort.abort('stop')
+        controller.enqueue(new Uint8Array([2]))
+        controller.close()
+      },
+    })
+    await expect(writeResponseAtomically(target, new Response(body), abort.signal)).rejects.toBe('stop')
+    expect(readFileSync(target, 'utf8')).toBe('existing')
+    expect(readdirSync(root)).toEqual(['session.zip'])
+  })
+
+  it('uses the native save dialog and starts the Host download only after selection', async () => {
+    const root = tempRoot()
+    const target = join(root, 'chosen.zip')
+    vi.mocked(dialog).showSaveDialog.mockResolvedValue({ canceled: false, filePath: target })
+    const sessionLog = vi.fn(async () => new Response(new Uint8Array([9, 8]), { status: 200 }))
+    await expect(exportSessionToFile(
+      {},
+      { downloads: { sessionLog } },
+      'session-1',
+      new AbortController().signal,
+    ))
+      .resolves.toEqual({ canceled: false })
+    expect(sessionLog).toHaveBeenCalledWith(
+      { sessionId: 'session-1', includeDescendants: true },
+      expect.any(AbortSignal),
+    )
+    expect([...readFileSync(target)]).toEqual([9, 8])
+    expect(sessionLogZipFilename('session/unsafe')).toBe('dsh-session-session_unsafe.zip')
+  })
+
+  it('does no Host work when the dialog is canceled and reports failed downloads', async () => {
+    vi.mocked(dialog).showSaveDialog.mockResolvedValue({ canceled: true, filePath: '' })
+    const sessionLog = vi.fn()
+    await expect(exportSessionToFile(
+      {},
+      { downloads: { sessionLog } },
+      'session-1',
+      new AbortController().signal,
+    ))
+      .resolves.toEqual({ canceled: true })
+    expect(sessionLog).not.toHaveBeenCalled()
+
+    const root = tempRoot()
+    vi.mocked(dialog).showSaveDialog.mockResolvedValue({ canceled: false, filePath: join(root, 'failed.zip') })
+    await expect(exportSessionToFile(
+      {},
+      { downloads: { sessionLog: async () => new Response('missing', { status: 404 }) } },
+      'session-1',
+      new AbortController().signal,
+    )).rejects.toThrow('Export failed: HTTP 404 missing')
+    expect(readdirSync(root)).toEqual([])
+  })
+})
