+                <span className={css.tabName}>{document.name}</span>
+                {dirty(document) && <span className={css.dirtyDot} aria-label={t('file.unsaved')} />}
+              </button>
+              <Tooltip label={t('file.closeTab')} side="bottom">
+                <button
+                  type="button"
+                  className={css.tabClose}
+                  aria-label={t('file.closeTab')}
+                  onClick={() => { closeTab(document) }}
+                >
+                  <X size={13} aria-hidden />
+                </button>
+              </Tooltip>
+            </div>
+          ))}
+        </div>
+        <Tooltip
+          label={explorerOpen ? t('file.explorer.hide') : t('file.explorer.show')}
+          side="bottom"
+        >
+          <button
+            type="button"
+            className={css.iconButton}
+            data-active={explorerOpen || undefined}
+            aria-label={explorerOpen ? t('file.explorer.hide') : t('file.explorer.show')}
+            aria-pressed={explorerOpen}
+            onClick={() => { setExplorerOpen(open => !open) }}
+          >
+            <FolderTree size={16} aria-hidden />
+          </button>
+        </Tooltip>
+        <Tooltip label={t('details.close')} side="bottom">
+          <button
+            type="button"
+            className={css.iconButton}
+            aria-label={t('details.close')}
+            onClick={() => { props.closeDetails() }}
+          >
+            <X size={16} aria-hidden />
+          </button>
+        </Tooltip>
+      </div>
+
+      <div className={css.toolbar}>
+        <div className={css.path} title={active.path}>{active.path}</div>
+        <div className={css.toolbarActions}>
+          {active.markdown && (
+            <div className={css.segmented} aria-label={t('file.viewMode')}>
+              {(['source', 'preview', 'split'] as const).map(mode => (
+                <button
+                  key={mode}
+                  type="button"
+                  data-active={active.viewMode === mode || undefined}
+                  onClick={() => { files.setViewMode(active.id, mode) }}
+                >
+                  {t(`file.mode.${mode}`)}
+                </button>
+              ))}
+            </div>
+          )}
+          <Tooltip label={t('file.undo')} side="bottom">
+            <button
+              type="button" className={css.iconButton} aria-label={t('file.undo')}
+              disabled={!active.loaded} onClick={() => { editors.current.get(active.id)?.undo() }}
+            >
+              <Undo2 size={16} aria-hidden />
+            </button>
+          </Tooltip>
+          <Tooltip label={t('file.redo')} side="bottom">
+            <button
+              type="button" className={css.iconButton} aria-label={t('file.redo')}
+              disabled={!active.loaded} onClick={() => { editors.current.get(active.id)?.redo() }}
+            >
+              <Redo2 size={16} aria-hidden />
+            </button>
+          </Tooltip>
+          <Tooltip label={t('file.reload')} side="bottom">
+            <button
+              type="button" className={css.iconButton} aria-label={t('file.reload')}
+              disabled={active.loading || active.saving} onClick={() => { reload(active) }}
+            >
+              <RefreshCw size={16} aria-hidden />
+            </button>
+          </Tooltip>
+          <Tooltip label={t('file.openExternal')} side="bottom">
+            <button
+              type="button" className={css.iconButton} aria-label={t('file.openExternal')}
+              onClick={() => { props.openExternal(active) }}
+            >
+              <ExternalLink size={16} aria-hidden />
+            </button>
+          </Tooltip>
+          <Tooltip label={t('file.save')} side="bottom">
+            <button
+              type="button" className={css.saveButton} aria-label={t('file.save')}
+              disabled={!active.loaded || !dirty(active) || active.loading || active.saving}
+              onClick={() => { void files.save(active.id) }}
+            >
+              <Save size={16} aria-hidden />
+              <span>{active.saving ? t('file.saving') : t('file.save')}</span>
+            </button>
+          </Tooltip>
+        </div>
+      </div>
+
+      {active.issue !== null && (
+        <div className={css.issue} role="alert" data-conflict={active.issue.code === 'workspace-file-conflict' || undefined}>
+          <span>{issueText(active.issue, t)}</span>
+          <button type="button" onClick={() => { reload(active) }}>{t('file.reload')}</button>
+        </div>
+      )}
+
+      <div className={css.workspaceSurface}>
+        <div className={css.documents}>
+          {state.documents.map(document => (
+            <div
+              key={document.id}
+              className={css.document}
+              data-active={document.id === active.id || undefined}
+              data-mode={document.viewMode}
+            >
+              {document.loading && !document.loaded
+                ? <div className={css.centerMessage}>{t('file.loading')}</div>
+                : !document.loaded
+                  ? <div className={css.centerMessage}>{t('file.unavailable')}</div>
+                  : (
+                    <>
+                      <div className={css.sourcePane}>
+                        <CodeEditor
+                          ref={(handle) => {
+                            if (handle === null) editors.current.delete(document.id)
+                            else editors.current.set(document.id, handle)
+                          }}
+                          value={document.content}
+                          path={document.path}
+                          label={t('file.editorLabel', { name: document.name })}
+                          onChange={(content) => { files.edit(document.id, content) }}
+                          onSave={() => { void files.save(document.id) }}
+                        />
+                      </div>
+                      {document.markdown && (
+                        <div className={css.previewPane}>
+                          <div className={css.previewContent}><MarkdownText text={document.content} /></div>
+                        </div>
+                      )}
+                    </>
+                  )}
+            </div>
+          ))}
+        </div>
+        {explorerOpen && (
+          <ProjectExplorer workspaceId={active.workspaceId} active={active} files={files} t={t} />
+        )}
+      </div>
+
+      <div className={css.statusbar}>
+        <span>{active.markdown ? 'Markdown' : active.name.split('.').at(-1)?.toUpperCase() ?? t('file.text')}</span>
+        <span>{active.saving ? t('file.saving') : dirty(active) ? t('file.unsaved') : t('file.saved')}</span>
+      </div>
+    </div>
+  )
+}
