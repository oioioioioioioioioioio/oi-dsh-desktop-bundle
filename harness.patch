+import { resolve } from 'node:path'
+import { Script } from 'node:vm'
+import { describe, expect, it } from 'vitest'
+import {
+  createElectronNativeProbeSource,
+  electronRuntimeDeployArgs,
+  parseElectronRuntimeArgs,
+  resolveElectronRuntimeTarget,
+} from './build-electron-runtime.ts'
+
+describe('Electron runtime build CLI', () => {
+  it('uses the isolated runtime defaults', () => {
+    expect(parseElectronRuntimeArgs([])).toEqual({
+      output: '.artifacts/electron-runtime',
+      skipBuild: false,
+      help: false,
+    })
+  })
+
+  it('parses build and output overrides', () => {
+    expect(parseElectronRuntimeArgs([
+      '--output=.artifacts/desktop-test',
+      '--skip-build',
+    ])).toEqual({
+      output: '.artifacts/desktop-test',
+      skipBuild: true,
+      help: false,
+    })
+  })
+
+  it('accepts the pnpm run argument separator', () => {
+    expect(parseElectronRuntimeArgs(['--', '--skip-build'])).toEqual({
+      output: '.artifacts/electron-runtime',
+      skipBuild: true,
+      help: false,
+    })
+  })
+
+  it('rejects unsupported native rebuild flags', () => {
+    expect(() => parseElectronRuntimeArgs(['--force-native-rebuild'])).toThrow('Unknown option')
+  })
+
+  it('allows only descendants of the repository artifact directory', () => {
+    const repository = resolve('C:/workspace/harness')
+    expect(resolveElectronRuntimeTarget(repository, '.artifacts/electron-runtime'))
+      .toBe(resolve(repository, '.artifacts/electron-runtime'))
+    expect(() => resolveElectronRuntimeTarget(repository, '.artifacts')).toThrow('must be a child')
+    expect(() => resolveElectronRuntimeTarget(repository, '../outside')).toThrow('must be a child')
+  })
+
+  it('deploys injected workspace snapshots without dependency lifecycle scripts', () => {
+    expect(electronRuntimeDeployArgs('C:/workspace/harness/.artifacts/electron-runtime')).toEqual([
+      '--config.inject-workspace-packages=true',
+      '--config.node-linker=hoisted',
+      '--filter', '@deepseek-ai/dsh-electron',
+      'deploy', '--prod', '--ignore-scripts',
+      'C:/workspace/harness/.artifacts/electron-runtime',
+    ])
+  })
+
+  it('renders a syntactically valid native probe program', () => {
+    const source = createElectronNativeProbeSource(
+      'C:/runtime/probe.json',
+      'C:/runtime/node-pty/lib/index.js',
+      'C:/runtime/koffi/index.cjs',
+      'file:///C:/runtime/app-boot/index.js',
+    )
+    expect(() => new Script(source)).not.toThrow()
+    expect(source).toContain('DSH_PTY_OK')
+    expect(source).toContain('file:///C:/runtime/app-boot/index.js')
+  })
+})
diff --git a/scripts/build-electron-runtime.ts b/scripts/build-electron-runtime.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d65025903e5520a09d956f8d52462773c6c4a50a
--- /dev/null
+++ b/scripts/build-electron-runtime.ts
@@ -0,0 +1,396 @@
+/** Build a standalone Electron runtime without changing workspace native modules. */
+
+import { spawn } from 'node:child_process'
+import { randomUUID } from 'node:crypto'
+import { existsSync } from 'node:fs'
+import { lstat, readFile, readdir, realpath, rm } from 'node:fs/promises'
+import { createRequire } from 'node:module'
+import { dirname, isAbsolute, join, relative, resolve, sep } from 'node:path'
+import { parseArgs } from 'node:util'
+import { fileURLToPath, pathToFileURL } from 'node:url'
+
+const root = resolve(import.meta.dirname, '..')
+const DEFAULT_OUTPUT = '.artifacts/electron-runtime'
+const ELECTRON_PACKAGE = '@deepseek-ai/dsh-electron'
+const PROBE_TEXT = 'DSH_PTY_OK'
+
+/** Validated command-line options for the Electron runtime build. */
+export interface ElectronRuntimeOptions {
+  /** Repository-relative or absolute output directory below `.artifacts`. */
+  readonly output: string
+  /** Reuse existing repository build outputs. */
+  readonly skipBuild: boolean
+  /** Print usage without changing files. */
+  readonly help: boolean
+}
+
+/** Parse the build script flags without performing filesystem work. */
+export function parseElectronRuntimeArgs(argv: string[]): ElectronRuntimeOptions {
+  const args = argv[0] === '--' ? argv.slice(1) : argv
+  const { values } = parseArgs({
+    args,
+    options: {
+      output: { type: 'string', default: DEFAULT_OUTPUT },
+      'skip-build': { type: 'boolean', default: false },
+      help: { type: 'boolean', short: 'h', default: false },
+    },
+    strict: true,
+    allowPositionals: false,
+  })
+  return {
+    output: values.output,
+    skipBuild: values['skip-build'],
+    help: values.help,
+  }
+}
+
+/** Resolve an output path and reject targets outside the repository artifact directory. */
+export function resolveElectronRuntimeTarget(repositoryRoot: string, output: string): string {
+  const canonicalRoot = resolve(repositoryRoot)
+  const artifacts = join(canonicalRoot, '.artifacts')
+  const target = isAbsolute(output) ? resolve(output) : resolve(canonicalRoot, output)
+  const rel = relative(artifacts, target)
+  if (rel === '' || rel === '..' || rel.startsWith(`..${sep}`) || isAbsolute(rel)) {
+    throw new Error(`build-electron-runtime: output must be a child of ${artifacts}, received ${target}`)
+  }
+  return target
+}
+
+/** Construct an isolated production deploy that never executes dependency lifecycle scripts. */
+export function electronRuntimeDeployArgs(target: string): string[] {
+  return [
+    '--config.inject-workspace-packages=true',
+    '--config.node-linker=hoisted',
+    '--filter', ELECTRON_PACKAGE,
+    'deploy', '--prod', '--ignore-scripts',
+    target,
+  ]
+}
+
+function usage(): string {
+  return [
+    'Usage: pnpm run build:electron -- [flags]',
+    '',
+    `  --output=<path>           output below .artifacts (default: ${DEFAULT_OUTPUT})`,
+    '  --skip-build              reuse existing lib/ and apps/web/dist outputs',
+    '  -h, --help                print this help',
+  ].join('\n')
+}
+
+function pnpmInvocation(args: string[]): readonly [command: string, args: string[]] {
+  const entrypoint = process.env.npm_execpath
+  if (entrypoint === undefined || entrypoint === '') {
+    throw new Error('build-electron-runtime: npm_execpath is unavailable; invoke through pnpm run build:electron')
+  }
+  return [process.execPath, [entrypoint, ...args]]
+}
+
+function formatCommand(command: string, args: readonly string[]): string {
+  return [command, ...args].map(value => value.includes(' ') ? JSON.stringify(value) : value).join(' ')
+}
+
+async function run(
+  label: string,
+  command: string,
+  args: string[],
+  options: { cwd?: string; env?: NodeJS.ProcessEnv } = {},
+): Promise<void> {
+  const printable = formatCommand(command, args)
+  console.log(`build-electron-runtime: ${label}: ${printable}`)
+  await new Promise<void>((resolveRun, rejectRun) => {
+    const child = spawn(command, args, {
+      cwd: options.cwd ?? root,
+      env: options.env ?? process.env,
+      stdio: 'inherit',
+      windowsHide: true,
+    })
+    child.once('error', (error) => {
+      rejectRun(new Error(
+        `build-electron-runtime: ${label} failed to spawn: ${error.message} (${printable})`,
+      ))
+    })
+    child.once('exit', (code, signal) => {
+      if (code === 0) resolveRun()
+      else rejectRun(new Error(
+        `build-electron-runtime: ${label} failed (${signal === null ? `exit ${String(code)}` : `signal ${signal}`}): ${printable}`,
+      ))
+    })
+  })
+}
+
+interface CapturedProcess {
+  readonly code: number | null
+  readonly signal: NodeJS.Signals | null
+  readonly stdout: string
+  readonly stderr: string
+}
+
+async function runCaptured(command: string, args: string[], cwd: string, env: NodeJS.ProcessEnv): Promise<CapturedProcess> {
+  return new Promise<CapturedProcess>((resolveRun, rejectRun) => {
+    const child = spawn(command, args, { cwd, env, windowsHide: true, stdio: ['ignore', 'pipe', 'pipe'] })
+    let stdout = ''
+    let stderr = ''
+    child.stdout.setEncoding('utf8')
+    child.stderr.setEncoding('utf8')
+    child.stdout.on('data', (chunk: string) => { stdout += chunk })
+    child.stderr.on('data', (chunk: string) => { stderr += chunk })
+    child.once('error', (error) => { rejectRun(error) })
+    child.once('exit', (code, signal) => { resolveRun({ code, signal, stdout, stderr }) })
+  })
+}
+
+function assertFile(path: string, label: string): void {
+  if (!existsSync(path)) throw new Error(`build-electron-runtime: deployed ${label} is missing: ${path}`)
+}
+
+interface RuntimePaths {
+  readonly electronDir: string
+  readonly electronManifest: string
+  readonly appBootEntry: string
+  readonly webIndex: string
+  readonly webLogo: string
+  readonly profileBoot: string
+  readonly desktopPatch: string
+  readonly nodePtyManifest: string
+  readonly nodePtyEntry: string
+  readonly koffiEntry: string
+}
+
+function runtimePaths(target: string): RuntimePaths {
+  const appRequire = createRequire(join(target, 'package.json'))
+  const electronManifest = appRequire.resolve('electron/package.json')
+  const webManifest = appRequire.resolve('@deepseek-ai/dsh-web-frontend/package.json')
+  const dshManifest = appRequire.resolve('@deepseek-ai/dsh/package.json')
+  const dshRequire = createRequire(dshManifest)
+  const electronAppManifest = dshRequire.resolve('@deepseek-ai/dsh-electron-app/package.json')
+  const electronAppRequire = createRequire(electronAppManifest)
+  const directoryPickerManifest = electronAppRequire.resolve(
+    '@deepseek-ai/dsh-host-directory-picker-native/package.json',
+  )
+  const baseManifest = dshRequire.resolve('@deepseek-ai/dsh-base/package.json')
+  const baseRequire = createRequire(baseManifest)
+  const subprocessManifest = baseRequire.resolve('@deepseek-ai/dsh-subprocess-local/package.json')
+  const subprocessRequire = createRequire(subprocessManifest)
+  return {
+    electronDir: dirname(electronManifest),
+    electronManifest,
+    appBootEntry: appRequire.resolve('@deepseek-ai/dsh-app-boot'),
+    webIndex: join(dirname(webManifest), 'dist/index.html'),
+    webLogo: join(dirname(webManifest), 'dist/logo.jpg'),
+    profileBoot: appRequire.resolve('@deepseek-ai/dsh/profile-boot'),
+    desktopPatch: dshRequire.resolve('@deepseek-ai/dsh-electron-app/cordis.patch.yml'),
+    nodePtyManifest: subprocessRequire.resolve('node-pty/package.json'),
+    nodePtyEntry: subprocessRequire.resolve('node-pty'),
+    koffiEntry: createRequire(directoryPickerManifest).resolve('koffi'),
+  }
+}
+
+async function electronExecutable(target: string): Promise<string> {
+  const { electronDir } = runtimePaths(target)
+  const relativePath = (await readFile(join(electronDir, 'path.txt'), 'utf8')).trim()
+  if (relativePath.length === 0) throw new Error('build-electron-runtime: Electron path.txt is empty')
+  const executable = resolve(electronDir, 'dist', relativePath)
+  assertFile(executable, 'Electron executable')
+  return executable
+}
+
+interface PtyProbeRecord {
+  readonly electron: string
+  readonly modules: string
+  readonly bootstrap?: boolean
+  readonly napi?: string
+  readonly exitCode?: number
+  readonly output?: string
+  readonly koffi?: string
+  readonly error?: string
+}
+
+/** Render the JavaScript program executed by Electron's Node-compatible process. */
+export function createElectronNativeProbeSource(
+  marker: string,
+  nodePtyEntry: string,
+  koffiEntry: string,
+  appBootUrl: string,
+): string {
+  const shell = process.platform === 'win32' ? 'cmd.exe' : '/bin/sh'
+  const shellArgs = process.platform === 'win32'
+    ? ['/d', '/s', '/c', `echo ${PROBE_TEXT}`]
+    : ['-c', `printf ${PROBE_TEXT}`]
+  return [
+    "const fs = require('node:fs')",
+    `const pty = require(${JSON.stringify(nodePtyEntry)})`,
+    `const koffi = require(${JSON.stringify(koffiEntry)})`,
+    `const marker = ${JSON.stringify(marker)}`,
+    'let output = ""',
+    'let settled = false',
+    'const write = record => {',
+    '  if (settled) return',
+    '  settled = true',
+    '  clearTimeout(timer)',
+    '  fs.writeFileSync(marker, JSON.stringify({',
+    '    electron: process.versions.electron, modules: process.versions.modules,',
+    '    napi: process.versions.napi, koffi: koffi.version, ...record,',
+    '  }))',
+    '  process.exit(record.error === undefined && record.exitCode === 0 ? 0 : 1)',
+    '}',
+    'const timer = setTimeout(() => write({ error: "PTY probe timed out" }), 10000)',
+    ';(async () => {',
+    'try {',
+    `  await import(${JSON.stringify(appBootUrl)})`,
+    `  const child = pty.spawn(${JSON.stringify(shell)}, ${JSON.stringify(shellArgs)}, {`,
+    '    name: "dumb", cols: 80, rows: 24, cwd: process.cwd(), env: process.env,',
+    '  })',
+    '  child.onData(data => { output += data })',
+    '  child.onExit(event => write({ bootstrap: true, exitCode: event.exitCode, output }))',
+    '} catch (error) {',
+    '  write({ error: error instanceof Error ? error.stack || error.message : String(error) })',
+    '}',
+    '})()',
+  ].join('\n')
+}
+
+async function probeNativePty(target: string): Promise<PtyProbeRecord> {
+  const marker = join(target, `.node-pty-electron-probe-${randomUUID()}.json`)
+  const executable = await electronExecutable(target)
+  const { appBootEntry, nodePtyEntry, koffiEntry } = runtimePaths(target)
+  try {
+    const result = await runCaptured(
+      executable,
+      ['-e', createElectronNativeProbeSource(
+        marker,
+        nodePtyEntry,
+        koffiEntry,
+        pathToFileURL(appBootEntry).href,
+      )],
+      target,
+      {
+        ...process.env,
+        ELECTRON_RUN_AS_NODE: '1',
+      },
+    )
+    let record: PtyProbeRecord | undefined
+    try {
+      record = JSON.parse(await readFile(marker, 'utf8')) as PtyProbeRecord
+    } catch {
+      // The process diagnostics below carry the actionable failure.
+    }
+    if (result.code !== 0 || result.signal !== null || record === undefined
+      || record.error !== undefined || record.bootstrap !== true
+      || record.exitCode !== 0 || !record.output?.includes(PROBE_TEXT)
+      || typeof record.koffi !== 'string' || record.koffi.length === 0) {
+      throw new Error([
+        'build-electron-runtime: deployed bootstrap/native modules failed their Electron probe',
+        `process: code=${String(result.code)} signal=${String(result.signal)}`,
+        `record: ${JSON.stringify(record)}`,
+        `stdout: ${result.stdout.trim()}`,
+        `stderr: ${result.stderr.trim()}`,
+      ].join('\n'))
+    }
+    return record
+  } finally {
+    await rm(marker, { force: true })
+  }
+}
+
+async function firstEscapingLink(directory: string, rootDirectory: string): Promise<string | undefined> {
+  for (const entry of await readdir(directory, { withFileTypes: true })) {
+    const path = join(directory, entry.name)
+    const metadata = await lstat(path)
+    if (metadata.isSymbolicLink()) {
+      const destination = await realpath(path)
+      const rel = relative(rootDirectory, destination)
+      if (rel === '..' || rel.startsWith(`..${sep}`) || isAbsolute(rel)) return path
+      continue
+    }
+    if (metadata.isDirectory()) {
+      const nested = await firstEscapingLink(path, rootDirectory)
+      if (nested !== undefined) return nested
+    }
+  }
+  return undefined
+}
+
+async function verifyRuntimeFiles(target: string): Promise<void> {
+  const paths = runtimePaths(target)
+  const required: ReadonlyArray<readonly [string, string]> = [
+    ['Electron main bundle', join(target, 'lib/main.js')],
+    ['sandboxed preload bundle', join(target, 'lib/preload.cjs')],
+    ['Web shell', paths.webIndex],
+    ['desktop logo', paths.webLogo],
+    ['profile boot entry', paths.profileBoot],
+    ['desktop profile patch', paths.desktopPatch],
+    ['node-pty manifest', paths.nodePtyManifest],
+    ['koffi entry', paths.koffiEntry],
+  ]
+  for (const [label, path] of required) assertFile(path, label)
+  const escapingLink = await firstEscapingLink(target, target)
+  if (escapingLink !== undefined) {
+    throw new Error(`build-electron-runtime: deployed runtime contains a link outside its root: ${escapingLink}`)
+  }
+}
+
+async function buildRepositoryArtifacts(): Promise<void> {
+  const [hostTypesCommand, hostTypesArgs] = pnpmInvocation(['exec', 'tsc', '-b', 'tsconfig.host.json'])
+  await run('Host TypeScript', hostTypesCommand, hostTypesArgs)
+  const [hostBundleCommand, hostBundleArgs] = pnpmInvocation([
+    'exec', 'tsdown', '--env.DSH_BUILD_FACE', 'host', '--logLevel', 'error', '--no-report',
+  ])
+  await run('Host bundles', hostBundleCommand, hostBundleArgs)
+  const [clientTypesCommand, clientTypesArgs] = pnpmInvocation(['exec', 'tsc', '-b', 'tsconfig.client.json'])
+  await run('Client TypeScript', clientTypesCommand, clientTypesArgs)
+  const [clientBundleCommand, clientBundleArgs] = pnpmInvocation([
+    'exec', 'tsdown', '--env.DSH_BUILD_FACE', 'client', '--logLevel', 'error', '--no-report',
+  ])
+  await run('Client bundles', clientBundleCommand, clientBundleArgs)
+  const [webCommand, webArgs] = pnpmInvocation(['--filter', '@deepseek-ai/dsh-web-frontend', 'run', 'build'])
+  await run('Web shell', webCommand, webArgs)
+}
+
+async function deploy(target: string): Promise<void> {
+  await rm(target, { recursive: true, force: true })
+  const [command, args] = pnpmInvocation(electronRuntimeDeployArgs(target))
+  await run('production deploy', command, args, { env: { ...process.env, CI: 'true' } })
+  const { electronDir } = runtimePaths(target)
+  await run('Electron binary install', process.execPath, [join(electronDir, 'install.js')], { cwd: electronDir })
+}
+
+async function buildElectronRuntime(options: ElectronRuntimeOptions): Promise<string> {
+  const target = resolveElectronRuntimeTarget(root, options.output)
+  if (!options.skipBuild) await buildRepositoryArtifacts()
+  else console.log('build-electron-runtime: reusing repository build outputs (--skip-build)')
+  const [closureCommand, closureArgs] = pnpmInvocation([
+    'exec', 'tsx', 'scripts/verify-runtime-closure.ts', '--manifest', 'apps/electron/package.json',
+  ])
+  await run('runtime dependency closure', closureCommand, closureArgs)
+  await deploy(target)
+  await verifyRuntimeFiles(target)
+
+  let record: PtyProbeRecord
+  try {
+    record = await probeNativePty(target)
+  } catch (error) {
+    throw new Error(
+      'build-electron-runtime: deployed native modules are incompatible with this Electron runtime; install compatible prebuilds before packaging',
+      { cause: error },
+    )
+  }
+  console.log(`build-electron-runtime: native modules passed Electron ${record.electron} (ABI ${record.modules})`)
+  return target
+}
+
+const scriptPath = fileURLToPath(import.meta.url)
+if (process.argv[1] !== undefined && resolve(process.argv[1]) === scriptPath) {
+  try {
+    const options = parseElectronRuntimeArgs(process.argv.slice(2))
+    if (options.help) {
+      console.log(usage())
+    } else {
+      const target = await buildElectronRuntime(options)
+      console.log(`build-electron-runtime: ready: ${target}`)
+      console.log('build-electron-runtime: start with: pnpm run start:electron')
+    }
+  } catch (error) {
+    console.error(error instanceof Error ? error.stack ?? error.message : String(error))
+    process.exitCode = 1
+  }
+}
