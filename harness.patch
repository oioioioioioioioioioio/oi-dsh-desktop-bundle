+
+function fakeFiles(
+  state: WorkspaceFilesState,
+  listDirectory: IWorkspaceFiles['listDirectory'] = (_workspaceId, path) => Promise.resolve({ path, entries: [] }),
+) {
+  const stateStore = createSnapshotStore(state)
+  const mocks = {
+    listDirectory: vi.fn(listDirectory),
+    open: vi.fn(() => Promise.resolve()),
+    deactivate: vi.fn(),
+    select: vi.fn(),
+    edit: vi.fn(),
+    setViewMode: vi.fn(),
+    reload: vi.fn(() => Promise.resolve()),
+    save: vi.fn(() => Promise.resolve()),
+    close: vi.fn(),
