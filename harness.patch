@@ -0,0 +1,273 @@
+/** Lazy Workspace project tree shown beside the file editor. */
+
+import { useCallback, useEffect, useMemo, useRef, useState } from 'react'
+import {
+  ChevronRight, File, FileCode2, FileText, Folder, FolderOpen, RefreshCw, Search, X,
+} from 'lucide-react'
+import { Tooltip } from '@deepseek-ai/dsh-client-ui-primitives'
+import type {
+  IWorkspaceFiles, WorkspaceDirectoryEntry, WorkspaceFileDocument, WorkspaceId,
+} from '@deepseek-ai/dsh-client-runtime/client'
+import type { DetailsPanelProps } from './DetailsPanel.tsx'
+import css from './FileWorkbench.module.css'
+import detailsCss from './DetailsPanel.module.css'
+
+type DirectoryState =
+  | { phase: 'loading'; entries: readonly WorkspaceDirectoryEntry[] }
+  | { phase: 'ready'; entries: readonly WorkspaceDirectoryEntry[] }
+  | { phase: 'error'; entries: readonly WorkspaceDirectoryEntry[] }
+
+type TreeRow =
+  | { kind: 'entry'; entry: WorkspaceDirectoryEntry; depth: number }
+  | { kind: 'status'; path: string; phase: 'loading' | 'error'; depth: number }
+
+export interface ProjectExplorerProps {
+  workspaceId: WorkspaceId
+  active?: WorkspaceFileDocument
+  files: IWorkspaceFiles
+  onOpenFile?: (path: string) => void
+  t: DetailsPanelProps['t']
+}
+
+interface ProjectExplorerPanelProps {
+  workspaceId: WorkspaceId
+  files: IWorkspaceFiles
+  openFile: (workspaceId: WorkspaceId, path: string) => void
+  closeDetails: () => void
+  t: DetailsPanelProps['t']
+}
+
+const CODE_SUFFIXES = new Set([
+  'c', 'cc', 'cpp', 'cs', 'css', 'go', 'h', 'hpp', 'html', 'java', 'js', 'jsx',
+  'kt', 'php', 'py', 'rb', 'rs', 'sh', 'swift', 'ts', 'tsx', 'vue', 'xml', 'yaml', 'yml',
+])
+
+function iconFor(entry: WorkspaceDirectoryEntry, expanded: boolean) {
+  if (entry.kind === 'directory') {
+    return expanded ? <FolderOpen size={15} aria-hidden /> : <Folder size={15} aria-hidden />
+  }
+  if (/\.(?:md|markdown)$/iu.test(entry.name)) return <FileText size={15} aria-hidden />
+  const suffix = entry.name.split('.').at(-1)?.toLowerCase()
+  return suffix !== undefined && CODE_SUFFIXES.has(suffix)
+    ? <FileCode2 size={15} aria-hidden />
+    : <File size={15} aria-hidden />
+}
+
+function activePath(document: WorkspaceFileDocument): string {
+  return document.path.replaceAll('\\', '/')
+}
+
+/** Project explorer with component-local expansion and request state. */
+export function ProjectExplorer({
+  workspaceId, active, files, onOpenFile, t,
+}: ProjectExplorerProps) {
+  const [directories, setDirectories] = useState<ReadonlyMap<string, DirectoryState>>(new Map())
+  const [expanded, setExpanded] = useState<ReadonlySet<string>>(new Set())
+  const [filter, setFilter] = useState('')
+  const directoryRef = useRef(new Map<string, DirectoryState>())
+  const requests = useRef(new Map<string, AbortController>())
+
+  const publishDirectories = useCallback((): void => {
+    setDirectories(new Map(directoryRef.current))
+  }, [])
+
+  const loadDirectory = useCallback((path: string, force = false): void => {
+    if (requests.current.has(path)) return
+    if (!force && directoryRef.current.get(path)?.phase === 'ready') return
+    const abort = new AbortController()
+    requests.current.set(path, abort)
+    const previous = directoryRef.current.get(path)?.entries ?? []
+    directoryRef.current.set(path, { phase: 'loading', entries: previous })
+    publishDirectories()
+    void files.listDirectory(workspaceId, path, abort.signal).then(
+      (listing) => {
+        if (requests.current.get(path) !== abort) return
+        directoryRef.current.set(path, { phase: 'ready', entries: listing.entries })
+        publishDirectories()
+      },
+      () => {
+        if (requests.current.get(path) !== abort || abort.signal.aborted) return
+        directoryRef.current.set(path, { phase: 'error', entries: previous })
+        publishDirectories()
+      },
+    ).finally(() => {
+      if (requests.current.get(path) === abort) requests.current.delete(path)
+    })
+  }, [files, publishDirectories, workspaceId])
+
+  useEffect(() => {
+    for (const request of requests.current.values()) request.abort()
+    requests.current.clear()
+    directoryRef.current.clear()
+    setDirectories(new Map())
+    setExpanded(new Set())
+    setFilter('')
+    loadDirectory('.')
+    return () => {
+      for (const request of requests.current.values()) request.abort()
+      requests.current.clear()
+    }
+  }, [loadDirectory])
+
+  const toggleDirectory = (path: string): void => {
+    const opening = !expanded.has(path)
+    setExpanded((current) => {
+      const next = new Set(current)
+      if (next.delete(path)) return next
+      next.add(path)
+      return next
+    })
+    if (opening) loadDirectory(path)
+  }
+
+  const refresh = (): void => {
+    for (const request of requests.current.values()) request.abort()
+    requests.current.clear()
+    directoryRef.current.clear()
+    setExpanded(new Set())
+    publishDirectories()
+    loadDirectory('.', true)
+  }
+
+  const rows = useMemo(() => {
+    const query = filter.trim().toLocaleLowerCase()
+    const collect = (path: string, depth: number): TreeRow[] => {
+      const directory = directories.get(path)
+      if (directory === undefined || directory.phase === 'loading') {
+        return [{ kind: 'status', path, phase: 'loading', depth }]
+      }
+      if (directory.phase === 'error' && directory.entries.length === 0) {
+        return [{ kind: 'status', path, phase: 'error', depth }]
+      }
+      const result: TreeRow[] = []
+      for (const entry of directory.entries) {
+        const childRows = entry.kind === 'directory' && directories.has(entry.path)
+          ? collect(entry.path, depth + 1)
+          : []
+        if (query !== '') {
+          const matches = entry.name.toLocaleLowerCase().includes(query)
+            || entry.path.toLocaleLowerCase().includes(query)
+          const visibleChildren = childRows.filter(row => row.kind === 'entry')
+          if (!matches && visibleChildren.length === 0) continue
+          result.push({ kind: 'entry', entry, depth }, ...visibleChildren)
+          continue
+        }
+        result.push({ kind: 'entry', entry, depth })
+        if (entry.kind === 'directory' && expanded.has(entry.path)) result.push(...childRows)
+      }
+      if (directory.phase === 'error') {
+        result.push({ kind: 'status', path, phase: 'error', depth })
+      }
+      return result
+    }
+    return collect('.', 0)
+  }, [directories, expanded, filter])
+
+  const normalizedActivePath = active === undefined ? undefined : activePath(active)
+
+  return (
+    <aside className={css.explorer} aria-label={t('file.explorer.title')}>
+      <div className={css.explorerToolbar}>
+        <div className={css.filterField}>
+          <Search size={14} aria-hidden />
+          <input
+            value={filter}
+            aria-label={t('file.explorer.filter')}
+            placeholder={t('file.explorer.filterPlaceholder')}
+            onChange={(event) => { setFilter(event.currentTarget.value) }}
+          />
+          {filter !== '' && (
+            <button type="button" aria-label={t('file.explorer.clearFilter')} onClick={() => { setFilter('') }}>
+              <X size={13} aria-hidden />
+            </button>
+          )}
+        </div>
+        <Tooltip label={t('file.explorer.refresh')} side="bottom">
+          <button type="button" className={css.iconButton} aria-label={t('file.explorer.refresh')} onClick={refresh}>
+            <RefreshCw size={15} aria-hidden />
+          </button>
+        </Tooltip>
+      </div>
+
+      <div className={css.tree} role="tree" aria-label={t('file.explorer.title')}>
+        {rows.map((row, index) => {
+          if (row.kind === 'status') {
+            return (
+              <div key={`${row.path}:${row.phase}:${String(index)}`} className={css.treeStatus} style={{ paddingLeft: `${String(12 + row.depth * 16)}px` }}>
+                {row.phase === 'loading'
+                  ? t('file.explorer.loading')
+                  : (
+                    <button type="button" onClick={() => { loadDirectory(row.path, true) }}>
+                      {t('file.explorer.retry')}
+                    </button>
+                  )}
+              </div>
+            )
+          }
+          const isExpanded = row.entry.kind === 'directory' && expanded.has(row.entry.path)
+          const selected = row.entry.kind === 'file' && normalizedActivePath !== undefined
+            && (normalizedActivePath === row.entry.path || normalizedActivePath.endsWith(`/${row.entry.path}`))
+          return (
+            <button
+              key={row.entry.path}
+              type="button"
+              role="treeitem"
+              aria-level={row.depth + 1}
+              aria-expanded={row.entry.kind === 'directory' ? isExpanded : undefined}
+              aria-selected={selected || undefined}
+              className={css.treeRow}
+              data-active={selected || undefined}
+              style={{ paddingLeft: `${String(8 + row.depth * 16)}px` }}
+              title={row.entry.path}
+              onClick={() => {
+                if (row.entry.kind === 'directory') toggleDirectory(row.entry.path)
+                else if (onOpenFile === undefined) void files.open(workspaceId, row.entry.path)
+                else onOpenFile(row.entry.path)
+              }}
+            >
+              <span className={css.chevron} data-hidden={row.entry.kind === 'file' || undefined}>
+                <ChevronRight size={14} aria-hidden />
+              </span>
+              <span className={css.treeIcon}>{iconFor(row.entry, isExpanded)}</span>
+              <span className={css.treeName}>{row.entry.name}</span>
+            </button>
+          )
+        })}
+        {rows.length === 0 && (
+          <div className={css.treeEmpty}>
+            {filter.trim() === '' ? t('file.explorer.empty') : t('file.explorer.noMatches')}
+          </div>
+        )}
+      </div>
+    </aside>
+  )
+}
+
+/** Standalone project directory shown when the details column has no active material. */
+export function ProjectExplorerPanel({
+  workspaceId, files, openFile, closeDetails, t,
+}: ProjectExplorerPanelProps) {
+  return (
+    <div className={`${detailsCss.root} ${css.explorerPanelRoot}`} data-project-explorer-panel>
+      <div className={detailsCss.header}>
+        <div className={detailsCss.title}>{t('file.explorer.title')}</div>
+        <Tooltip label={t('details.close')} side="bottom">
+          <button
+            type="button"
+            className={detailsCss.close}
+            aria-label={t('details.close')}
+            onClick={closeDetails}
+          >
+            <X size={16} aria-hidden />
+          </button>
+        </Tooltip>
+      </div>
+      <ProjectExplorer
+        workspaceId={workspaceId}
+        files={files}
+        onOpenFile={(path) => { openFile(workspaceId, path) }}
+        t={t}
+      />
+    </div>
+  )
+}
