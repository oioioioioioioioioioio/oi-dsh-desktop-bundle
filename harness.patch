index 0000000000000000000000000000000000000000..3a9db5d537ff6422600b23923e44a2299db171a0
--- /dev/null
+++ b/packages/client/ui-workspace/src/client/workspace-references.ts
@@ -0,0 +1,278 @@
+/** Workspace-relative file and folder references for the conversation input. */
+
+import type {
+  IWorkspaces, WorkspaceDirectoryListing, WorkspaceId,
+} from '@deepseek-ai/dsh-client-runtime/client'
+import type {
+  CandidateRequest, ClientSessionContext, InputTriggerCandidate, InputTriggerSource, PickOutcome,
+} from '@deepseek-ai/dsh-client-ui-input-trigger/client'
+
+type WorkspaceReferenceKind = 'file' | 'folder'
+
+interface WorkspacePathIndex {
+  readonly files: readonly string[]
+  readonly folders: readonly string[]
+}
+
+interface CachedWorkspaceIndex {
+  readonly abort: AbortController
+  readonly promise: Promise<WorkspacePathIndex>
+  readonly state: { settled: boolean }
+}
+
+interface PendingDirectory {
+  readonly path: string
+  readonly deferred: boolean
+}
+
+interface ParsedQuery {
+  readonly mode: 'command' | 'search'
+  readonly search: string
+}
+
+const COMMAND_HINT = 'workspace-reference-command'
+const RESULT_HINT = 'workspace-reference-result'
+const ROOT_PATH = '.'
+const SCAN_CONCURRENCY = 6
+const MAX_INDEXED_PATHS = 20_000
+const MAX_CANDIDATES = 40
+
+const EXCLUDED_DIRECTORIES = new Set(['.git', '.svn', '.hg', '.bzr', '.jj', '.sl'])
+const DEFERRED_DIRECTORIES = new Set([
+  'node_modules', '.pnpm', '.yarn', '.cache', '.next', '.nuxt', 'coverage', 'dist', 'build', 'vendor',
+])
+
+function abortReason(signal: AbortSignal): Error {
+  if (signal.reason instanceof Error) return signal.reason
+  const error = new Error('workspace reference search aborted')
+  error.name = 'AbortError'
+  return error
+}
+
+function throwIfAborted(signal: AbortSignal): void {
+  if (signal.aborted) throw abortReason(signal)
+}
+
+function waitWithSignal<T>(promise: Promise<T>, signal: AbortSignal): Promise<T> {
+  throwIfAborted(signal)
+  return new Promise<T>((resolve, reject) => {
+    const onAbort = (): void => { reject(abortReason(signal)) }
+    signal.addEventListener('abort', onAbort, { once: true })
+    void promise.then(
+      (value) => {
+        signal.removeEventListener('abort', onAbort)
+        resolve(value)
+      },
+      (error: unknown) => {
+        signal.removeEventListener('abort', onAbort)
+        reject(error instanceof Error ? error : new Error(String(error)))
+      },
+    )
+  })
+}
+
+function parseQuery(kind: WorkspaceReferenceKind, query: string): ParsedQuery | null {
+  const command = kind
+  const lower = query.toLowerCase()
+  if (!lower.includes(':')) {
+    return command.startsWith(lower) ? { mode: 'command', search: '' } : null
+  }
+  const prefix = `${command}:`
+  if (!lower.startsWith(prefix)) return null
+  return {
+    mode: 'search',
+    search: query.slice(prefix.length).replace(/^"/u, '').replace(/"$/u, ''),
+  }
+}
+
+function formatReference(kind: WorkspaceReferenceKind, path: string): string {
+  const encoded = /[\s"\\]/u.test(path) ? JSON.stringify(path) : path
+  return `@${kind}:${encoded}`
+}
+
+function textOrder(a: string, b: string): number {
+  return a.localeCompare(b, 'en', { sensitivity: 'variant' })
+}
+
+function subsequencePenalty(haystack: string, needle: string): number | null {
+  let cursor = -1
+  let first = -1
+  for (const char of needle) {
+    cursor = haystack.indexOf(char, cursor + 1)
+    if (cursor < 0) return null
+    if (first < 0) first = cursor
+  }
+  return first * 100 + (cursor - first - needle.length + 1)
+}
+
+function pathScore(path: string, rawQuery: string): number | null {
+  const candidate = path.replace(/\\/gu, '/').toLowerCase()
+  const query = rawQuery.trim().replace(/\\/gu, '/').toLowerCase()
+  const basename = candidate.slice(candidate.lastIndexOf('/') + 1)
+  if (query === '') return candidate.split('/').length * 100 + candidate.length
+  if (basename === query) return basename.length
+  if (basename.startsWith(query)) return 10_000 + basename.length
+  if (candidate.startsWith(query)) return 20_000 + candidate.length
+  const basenameIndex = basename.indexOf(query)
+  if (basenameIndex >= 0) return 30_000 + basenameIndex * 100 + basename.length
+  const pathIndex = candidate.indexOf(query)
+  if (pathIndex >= 0) return 40_000 + pathIndex * 100 + candidate.length
+  const basenameSubsequence = subsequencePenalty(basename, query)
+  if (basenameSubsequence !== null) return 50_000 + basenameSubsequence + basename.length
+  const pathSubsequence = subsequencePenalty(candidate, query)
+  return pathSubsequence === null ? null : 60_000 + pathSubsequence + candidate.length
+}
+
+function searchPaths(paths: readonly string[], query: string): InputTriggerCandidate[] {
+  return paths
+    .map(path => ({ path, score: pathScore(path, query) }))
+    .filter((item): item is { path: string; score: number } => item.score !== null)
+    .sort((a, b) => a.score - b.score || a.path.length - b.path.length || textOrder(a.path, b.path))
+    .slice(0, MAX_CANDIDATES)
+    .map(({ path }) => ({ name: path, hint: RESULT_HINT }))
+}
+
+async function listDirectory(
+  workspaces: IWorkspaces,
+  workspaceId: WorkspaceId,
+  directory: PendingDirectory,
+  signal: AbortSignal,
+): Promise<{ directory: PendingDirectory; listing: WorkspaceDirectoryListing | null }> {
+  try {
+    const listing = await workspaces.files.listDirectory(workspaceId, directory.path, signal)
+    return { directory, listing }
+  } catch (error: unknown) {
+    if (signal.aborted || directory.path === ROOT_PATH) throw error
+    return { directory, listing: null }
+  }
+}
+
+async function buildIndex(
+  workspaces: IWorkspaces,
+  workspaceId: WorkspaceId,
+  signal: AbortSignal,
+): Promise<WorkspacePathIndex> {
+  const files: string[] = []
+  const folders: string[] = []
+  const immediate: PendingDirectory[] = [{ path: ROOT_PATH, deferred: false }]
+  const deferred: PendingDirectory[] = []
+  let indexed = 0
+
+  while ((immediate.length > 0 || deferred.length > 0) && indexed < MAX_INDEXED_PATHS) {
+    throwIfAborted(signal)
+    const queue = immediate.length > 0 ? immediate : deferred
+    const batch = queue.splice(0, SCAN_CONCURRENCY)
+    const levels = await Promise.all(batch.map(directory => (
+      listDirectory(workspaces, workspaceId, directory, signal)
+    )))
+    for (const { directory, listing } of levels) {
+      if (listing === null) continue
+      for (const entry of listing.entries) {
+        const name = entry.name.toLowerCase()
+        if (entry.kind === 'directory' && EXCLUDED_DIRECTORIES.has(name)) continue
+        if (entry.kind === 'directory') folders.push(entry.path)
+        else files.push(entry.path)
+        indexed += 1
+        if (indexed >= MAX_INDEXED_PATHS) break
+        if (entry.kind === 'directory') {
+          const child = { path: entry.path, deferred: directory.deferred || DEFERRED_DIRECTORIES.has(name) }
+          if (child.deferred) deferred.push(child)
+          else immediate.push(child)
+        }
+      }
+      if (indexed >= MAX_INDEXED_PATHS) break
+    }
+  }
+  return { files, folders }
+}
+
+/**
+ * Owns the shared Workspace path index and the `@file` / `@folder` trigger sources.
+ * Candidate cancellation stops only that lookup; the shared scan survives query changes and is aborted on disposal.
+ */
+export class WorkspaceReferenceCatalog {
+  /** Registered `@file` and `@folder` sources, in menu order. */
+  readonly sources: readonly InputTriggerSource[]
+  private readonly cache = new Map<WorkspaceId, CachedWorkspaceIndex>()
+
+  /**
+   * @param workspaces - Workspace list and bounded directory-listing service.
+   */
+  constructor(private readonly workspaces: IWorkspaces) {
+    this.sources = [this.createSource('file', 20), this.createSource('folder', 21)]
+  }
+
+  /** Abort in-flight scans and release every cached index. */
+  dispose(): void {
+    for (const entry of this.cache.values()) entry.abort.abort()
+    this.cache.clear()
+  }
+
+  private createSource(kind: WorkspaceReferenceKind, order: number): InputTriggerSource {
+    const name = `workspace-${kind}`
+    return {
+      trigger: '@',
+      name,
+      order,
+      candidates: (session, request) => this.candidates(kind, session, request),
+      onPick: ({ candidate }): PickOutcome => {
+        if (candidate.hint === COMMAND_HINT) return { text: `@${kind}:` }
+        if (candidate.hint !== RESULT_HINT) return undefined
+        const clipboardText = formatReference(kind, candidate.name)
+        return {
+          insert: {
+            source: name,
+            ref: candidate.name,
+            label: clipboardText,
+            clipboardText,
+          },
+        }
+      },
+      codec: {
+        clipboardText: path => formatReference(kind, path),
+        serialize: (path, signal) => {
+          if (signal.aborted) return Promise.reject(abortReason(signal))
+          return Promise.resolve(formatReference(kind, path))
+        },
+      },
+    }
+  }
+
+  private async candidates(
+    kind: WorkspaceReferenceKind,
+    session: ClientSessionContext,
+    request: CandidateRequest,
+  ): Promise<readonly InputTriggerCandidate[]> {
+    throwIfAborted(request.signal)
+    const parsed = parseQuery(kind, request.query)
+    if (parsed === null) return []
+    const workspace = this.workspaces.list.getSnapshot().items
+      .find(item => item.sessionIds.includes(session.sessionId))
+    if (workspace === undefined) return []
+    if (parsed.mode === 'command') return [{ name: kind, hint: COMMAND_HINT }]
+    const promise = this.index(workspace.workspaceId, parsed.search === '')
+    const index = await waitWithSignal(promise, request.signal)
+    const paths = kind === 'file' ? index.files : index.folders
+    return searchPaths(paths, parsed.search)
+  }
+
+  private index(workspaceId: WorkspaceId, refresh: boolean): Promise<WorkspacePathIndex> {
+    const current = this.cache.get(workspaceId)
+    if (current !== undefined && (!refresh || !current.state.settled)) return current.promise
+    const abort = new AbortController()
+    const state = { settled: false }
+    const promise = buildIndex(this.workspaces, workspaceId, abort.signal).then(
+      (value) => {
+        state.settled = true
+        return value
+      },
+      (error: unknown) => {
+        if (this.cache.get(workspaceId)?.abort === abort) this.cache.delete(workspaceId)
+        throw error
+      },
+    )
+    const entry: CachedWorkspaceIndex = { abort, promise, state }
+    this.cache.set(workspaceId, entry)
+    return entry.promise
+  }
+}
