+    id: 'workspace\u0000README.md',
+    workspaceId: 'workspace' as WorkspaceId,
+    path: 'README.md',
+    name: 'README.md',
+    content: '# Preview\n',
+    savedContent: '# Preview\n',
+    version: 'v1',
+    size: 10,
+    markdown: true,
+    viewMode: 'preview',
+    loaded: true,
+    loading: false,
+    saving: false,
+    issue: null,
+    ...overrides,
+  }
