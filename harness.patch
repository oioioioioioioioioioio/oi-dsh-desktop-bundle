+// @vitest-environment jsdom
+
+import { createRef } from 'react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { act, cleanup, fireEvent, render } from '@testing-library/react'
+import { EditorView } from '@codemirror/view'
+import { CodeEditor, type CodeEditorHandle } from '../src/client/skeleton/CodeEditor.tsx'
+
+afterEach(cleanup)
+
+describe('CodeEditor', () => {
+  it('publishes edits, retains undo/redo history, syncs replacement content, and handles Mod-S', () => {
+    const ref = createRef<CodeEditorHandle>()
+    const onChange = vi.fn()
+    const onSave = vi.fn()
+    const view = render(
+      <CodeEditor
+        ref={ref}
+        value={'const value = 1\n'}
+        path="src/value.ts"
+        label="Edit value.ts"
+        onChange={onChange}
+        onSave={onSave}
+      />,
+    )
+    const editorElement = view.container.querySelector('.cm-editor')
+    if (!(editorElement instanceof HTMLElement)) throw new Error('CodeMirror editor missing')
+    const editor = EditorView.findFromDOM(editorElement)
+    if (editor === null) throw new Error('CodeMirror view missing')
+
+    act(() => {
+      editor.dispatch({ changes: { from: 14, to: 15, insert: '2' } })
+    })
+    expect(onChange).toHaveBeenLastCalledWith('const value = 2\n')
+    act(() => { ref.current?.undo() })
+    expect(onChange).toHaveBeenLastCalledWith('const value = 1\n')
+    act(() => { ref.current?.redo() })
+    expect(onChange).toHaveBeenLastCalledWith('const value = 2\n')
+
+    fireEvent.keyDown(editor.contentDOM, { key: 's', code: 'KeyS', ctrlKey: true })
+    expect(onSave).toHaveBeenCalledTimes(1)
+
+    view.rerender(
+      <CodeEditor
+        ref={ref}
+        value={'export const external = true\n'}
+        path="src/value.ts"
+        label="Edit value.ts"
+        onChange={onChange}
+        onSave={onSave}
+      />,
+    )
+    expect(editor.state.doc.toString()).toBe('export const external = true\n')
+  })
+
+  it('syntax-highlights C and C++ documents', () => {
+    const view = render(
+      <CodeEditor
+        value={'#include <vector>\nint main() { return 0; }\n'}
+        path="src/MainComponent.cpp"
+        label="Edit MainComponent.cpp"
+        onChange={vi.fn()}
+        onSave={vi.fn()}
+      />,
+    )
+    const tokens = [...view.container.querySelectorAll('.cm-content span')]
+    expect(tokens.some(token => token.textContent === 'return')).toBe(true)
+  })
+})
