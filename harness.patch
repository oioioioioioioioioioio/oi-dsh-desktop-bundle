diff --git a/start-deepseek-harness.cmd b/start-deepseek-harness.cmd
new file mode 100644
index 0000000000000000000000000000000000000000..65a78fff90de008377a9e9573b16dd6b0a69db90
--- /dev/null
+++ b/start-deepseek-harness.cmd
@@ -0,0 +1,23 @@
+@echo off
+setlocal
+
+set "ROOT=%~dp0"
+set "ELECTRON=%ROOT%.artifacts\electron-runtime\node_modules\electron\dist\electron.exe"
+set "MAIN=%ROOT%.artifacts\electron-runtime\lib\main.js"
+
+if not exist "%ELECTRON%" (
+  echo Electron runtime not found.
+  echo Build it first with: pnpm run build:electron
+  pause
+  exit /b 1
+)
+
+if not exist "%MAIN%" (
+  echo Electron main process not found: %MAIN%
+  pause
+  exit /b 1
+)
+
+pushd "%ROOT%"
+start "DeepSeek Harness" "%ELECTRON%" "%MAIN%"
+popd
