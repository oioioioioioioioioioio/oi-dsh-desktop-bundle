+/** Browser-safe data protocol exposed by an Electron preload bridge. */
+
+/** Request fields accepted by the Electron preload bridge. */
+export interface DesktopRequest {
+  readonly path: string
+  readonly method: string
+  readonly headers: Array<[string, string]>
+  readonly body?: string
+}
+
+/** Complete response returned by the Electron preload bridge. */
+export interface DesktopResponse {
+  readonly status: number
+  readonly headers: Array<[string, string]>
+  readonly body: string
+}
+
+/** One lifecycle message for an Electron event stream. */
+export type DesktopStreamMessage =
+  | { readonly id: string; readonly type: 'open' }
+  | { readonly id: string; readonly type: 'frame'; readonly frame: unknown }
+  | { readonly id: string; readonly type: 'end' }
+  | { readonly id: string; readonly type: 'error'; readonly message: string }
+
+/** Native state required to render the custom Electron title bar. */
+export interface DesktopWindowState {
+  readonly maximized: boolean
+  readonly fullScreen: boolean
+}
+
+/** Narrow native-window API exposed to the custom Electron title bar. */
+export interface DesktopWindowControls {
+  getState(): Promise<DesktopWindowState>
+  minimize(): void
+  toggleMaximize(): void
+  close(): void
+  onStateChange(listener: (state: DesktopWindowState) => void): () => void
+}
+
+/** Narrow renderer API exposed by the Electron preload script. */
+export interface DshDesktopBridge {
+  /** Native operations available only to the desktop shell chrome. */
+  readonly windowControls: DesktopWindowControls
+  /** Write exact text through Electron's main-process system clipboard. */
+  writeClipboard(text: string): Promise<void>
+  /** Read the Host-composed client module graph before the shell boots. */
+  boot(): Promise<unknown>
+  request(id: string, request: DesktopRequest): Promise<DesktopResponse>
+  cancelRequest(id: string): void
+  openStream(id: string, kind: 'mux' | 'host'): Promise<void>
+  closeStream(id: string): void
+  onStreamMessage(listener: (message: DesktopStreamMessage) => void): () => void
+  exportSession(sessionId: string): Promise<{ canceled: boolean }>
+}
