+  closeDetails(): void
+  t: DetailsPanelProps['t']
+}
+
+function dirty(document: WorkspaceFileDocument): boolean {
+  return document.content !== document.savedContent
+}
+
+function issueText(issue: WorkspaceFileIssue, t: FileWorkbenchProps['t']): string {
+  switch (issue.code) {
+    case 'workspace-file-conflict': return t('file.issue.conflict')
+    case 'workspace-file-outside': return t('file.issue.outside')
+    case 'workspace-file-write-failed': return t('file.issue.write')
+    case 'workspace-file-not-readable':
+      switch (issue.reason) {
+        case 'not-text': return t('file.issue.notText')
+        case 'too-large': return t('file.issue.tooLarge')
+        case 'not-regular': return t('file.issue.notRegular')
+        case 'permission': return t('file.issue.permission')
+        case 'not-found': return t('file.issue.notFound')
+        default: return t('file.issue.read')
+      }
+    default: return issue.message
+  }
+}
+
+/** Complete file-workbench surface shown in place of tool-call details. */
+export function FileWorkbench(props: FileWorkbenchProps) {
+  const { state, files, t } = props
+  const active = state.documents.find(document => document.id === state.activeId)
+  const editors = useRef(new Map<string, CodeEditorHandle>())
+  const [explorerOpen, setExplorerOpen] = useState(true)
+
+  useEffect(() => {
+    if (active === undefined) return
+    const onKeyDown = (event: KeyboardEvent): void => {
+      if (event.defaultPrevented || event.key.toLowerCase() !== 's' || (!event.ctrlKey && !event.metaKey)) return
+      event.preventDefault()
+      void files.save(active.id)
+    }
+    window.addEventListener('keydown', onKeyDown)
+    return () => { window.removeEventListener('keydown', onKeyDown) }
+  }, [active, files])
+
+  const confirmDiscard = (document: WorkspaceFileDocument): boolean =>
+    !dirty(document) || window.confirm(t('file.confirmDiscard', { name: document.name }))
+
+  const closeTab = (document: WorkspaceFileDocument): void => {
+    if (confirmDiscard(document)) files.close(document.id)
+  }
+
