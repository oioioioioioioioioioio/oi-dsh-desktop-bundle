@@ -0,0 +1,161 @@
+/** Electron IPC client carrier behavior. */
+
+import { describe, expect, it, vi } from 'vitest'
+import type {
+  DesktopRequest,
+  DesktopResponse,
+  DesktopStreamMessage,
+  DshDesktopBridge,
+} from '../src/electron.ts'
+import { ElectronApiClient } from '../src/client/electron-api-client.ts'
+
+class FakeDesktop implements DshDesktopBridge {
+  readonly requests: Array<{ id: string; request: DesktopRequest }> = []
+  readonly canceled: string[] = []
+  readonly opened: Array<{ id: string; kind: 'mux' | 'host' }> = []
+  readonly closed: string[] = []
+  private readonly listeners = new Set<(message: DesktopStreamMessage) => void>()
+  responder: (request: DesktopRequest) => DesktopResponse | Promise<DesktopResponse> = request => ({
+    status: 404, headers: [], body: request.path,
+  })
+  readonly windowControls = {
+    getState: () => Promise.resolve({ maximized: false, fullScreen: false }),
+    minimize: () => {},
+    toggleMaximize: () => {},
+    close: () => {},
+    onStateChange: () => () => {},
+  }
+
+  boot(): Promise<unknown> {
+    return Promise.resolve({ rev: 'fixture', entries: [] })
+  }
+
+  writeClipboard(): Promise<void> {
+    return Promise.resolve()
+  }
+
+  request(id: string, request: DesktopRequest): Promise<DesktopResponse> {
+    this.requests.push({ id, request })
+    return Promise.resolve(this.responder(request))
+  }
+
+  cancelRequest(id: string): void {
+    this.canceled.push(id)
+  }
+
+  openStream(id: string, kind: 'mux' | 'host'): Promise<void> {
+    this.opened.push({ id, kind })
+    this.emit({ id, type: 'open' })
+    return Promise.resolve()
+  }
+
+  closeStream(id: string): void {
+    this.closed.push(id)
+  }
+
+  onStreamMessage(listener: (message: DesktopStreamMessage) => void): () => void {
+    this.listeners.add(listener)
+    return () => { this.listeners.delete(listener) }
+  }
+
+  exportSession(): Promise<{ canceled: boolean }> {
+    return Promise.resolve({ canceled: false })
+  }
+
+  emit(message: DesktopStreamMessage): void {
+    for (const listener of this.listeners) listener(message)
+  }
+}
+
+describe('Electron API client', () => {
+  it('serializes unary requests and parses their response through AbstractApiClient', async () => {
+    const desktop = new FakeDesktop()
+    desktop.responder = (request) => {
+      const message = JSON.parse(request.body ?? '') as { rpcId: string }
+      return {
+        status: 200,
+        headers: [['content-type', 'application/json']],
+        body: JSON.stringify({
+          type: 'server-response',
+          rpcId: message.rpcId,
+          result: {
+            ok: true,
+            value: {
+              version: 'desktop-test', cwd: 'C:\\repo', attachedSessions: 0, canOpenPath: true,
+            },
+          },
+        }),
+      }
+    }
+    const client = new ElectronApiClient(desktop)
+    await expect(client.host.describe({})).resolves.toMatchObject({
+      result: { ok: true, value: { version: 'desktop-test', canOpenPath: true } },
+    })
+    expect(desktop.requests).toHaveLength(1)
+    expect(desktop.requests[0]?.request).toMatchObject({
+      path: '/api/host.describe',
+      method: 'POST',
+      headers: [['content-type', 'application/json']],
+    })
+  })
+
+  it('installs the stream listener before opening and forwards valid frames', async () => {
+    const desktop = new FakeDesktop()
+    const client = new ElectronApiClient(desktop)
+    const opened = vi.fn()
+    const abort = new AbortController()
+    const iterator = client.events.host({}, abort.signal, opened)[Symbol.asyncIterator]()
+    const frame = iterator.next()
+    await vi.waitFor(() => { expect(desktop.opened).toHaveLength(1) })
+    const id = desktop.opened[0]!.id
+    desktop.emit({
+      id,
+      type: 'frame',
+      frame: {
+        type: 'server-request',
+        rpcId: 'host-electron',
+        method: 'host/session-status',
+        payload: { type: 'host/session-status', sessionId: 'session-1', running: true },
+      },
+    })
+    await expect(frame).resolves.toMatchObject({
+      value: { rpcId: 'host-electron', payload: { type: 'host/session-status', running: true } },
+    })
+    expect(opened).toHaveBeenCalledOnce()
+    const ended = iterator.next()
+    desktop.emit({ id, type: 'end' })
+    await expect(ended).resolves.toMatchObject({ done: true })
+    expect(desktop.closed).toContain(id)
+  })
+
+  it('drops malformed stream frames and closes on abort', async () => {
+    const desktop = new FakeDesktop()
+    const client = new ElectronApiClient(desktop)
+    const abort = new AbortController()
+    const errors = vi.spyOn(console, 'error').mockImplementation(() => undefined)
+    const iterator = client.events.mux({}, abort.signal)[Symbol.asyncIterator]()
+    const pending = iterator.next()
+    await vi.waitFor(() => { expect(desktop.opened).toHaveLength(1) })
+    const id = desktop.opened[0]!.id
+    desktop.emit({ id, type: 'frame', frame: { invalid: true } })
+    expect(errors).toHaveBeenCalledOnce()
+    abort.abort()
+    await expect(pending).resolves.toMatchObject({ done: true })
+    expect(desktop.closed).toContain(id)
+    errors.mockRestore()
+  })
+
+  it('cancels an active request and rejects after caller abort', async () => {
+    const desktop = new FakeDesktop()
+    const response = Promise.withResolvers<DesktopResponse>()
+    desktop.responder = () => response.promise
+    const client = new ElectronApiClient(desktop)
+    const abort = new AbortController()
+    const pending = client.host.describe({}, abort.signal)
+    await vi.waitFor(() => { expect(desktop.requests).toHaveLength(1) })
+    abort.abort(new Error('caller stopped'))
+    response.resolve({ status: 200, headers: [], body: '{}' })
+    await expect(pending).rejects.toThrow('caller stopped')
+    expect(desktop.canceled).toEqual([desktop.requests[0]!.id])
+  })
+})
