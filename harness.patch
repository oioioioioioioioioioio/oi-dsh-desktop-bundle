+  IWorkspaceFiles, WorkspaceFileDocument, WorkspaceFileIssue, WorkspaceFilesState,
+} from '@deepseek-ai/dsh-client-runtime/client'
+import type { DetailsPanelProps } from './DetailsPanel.tsx'
+import { CodeEditor, type CodeEditorHandle } from './CodeEditor.tsx'
+import { ProjectExplorer } from './ProjectExplorer.tsx'
+import css from './FileWorkbench.module.css'
+
+/** File-workbench actions composed by the details registration. */
+export interface FileWorkbenchProps {
+  state: WorkspaceFilesState
+  files: IWorkspaceFiles
