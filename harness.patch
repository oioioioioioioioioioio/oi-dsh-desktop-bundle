diff --git a/packages/client/ui-workspace/tests/workspace-references.client.spec.ts b/packages/client/ui-workspace/tests/workspace-references.client.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0ada10b22116e822170e567bde650df7aadf9530
--- /dev/null
+++ b/packages/client/ui-workspace/tests/workspace-references.client.spec.ts
@@ -0,0 +1,249 @@
+import { describe, expect, it, vi } from 'vitest'
+import type {
+  IWorkspaces, SessionId, WorkspaceDirectoryEntry, WorkspaceDirectoryListing, WorkspaceId,
+} from '@deepseek-ai/dsh-client-runtime/client'
+import type {
+  CandidateRequest, ClientSessionContext, InputTriggerCandidate, InputTriggerSource,
+} from '@deepseek-ai/dsh-client-ui-input-trigger/client'
+import { WorkspaceReferenceCatalog } from '../src/client/workspace-references.ts'
+
+const SID = 'session-1' as SessionId
+const WID = 'workspace-1' as WorkspaceId
+const session: ClientSessionContext = { sessionId: SID }
+
+function request(query: string, signal = new AbortController().signal): CandidateRequest {
+  return { query, signal, position: 'inline' }
+}
+
+function entry(path: string, kind: WorkspaceDirectoryEntry['kind']): WorkspaceDirectoryEntry {
+  return { path, name: path.split('/').at(-1)!, kind }
+}
+
+function level(path: string, entries: WorkspaceDirectoryEntry[]): WorkspaceDirectoryListing {
+  return { path, entries }
+}
+
+const TREE = new Map<string, WorkspaceDirectoryListing>([
+  ['.', level('.', [
+    entry('.git', 'directory'),
+    entry('src', 'directory'),
+    entry('docs', 'directory'),
+    entry('node_modules', 'directory'),
+    entry('README.md', 'file'),
+  ])],
+  ['src', level('src', [
+    entry('src/components', 'directory'),
+    entry('src/main.ts', 'file'),
+    entry('src/main.tsx', 'file'),
+    entry('src/domain.ts', 'file'),
+  ])],
+  ['src/components', level('src/components', [entry('src/components/MainPanel.tsx', 'file')])],
+  ['docs', level('docs', [
+    entry('docs/guides', 'directory'),
+    entry('docs/main.ts-guide.txt', 'file'),
+    entry('docs/my guide.txt', 'file'),
+  ])],
+  ['docs/guides', level('docs/guides', [entry('docs/guides/setup.txt', 'file')])],
+  ['node_modules', level('node_modules', [entry('node_modules/dependency.js', 'file')])],
+])
+
+function bench(options: {
+  tree?: ReadonlyMap<string, WorkspaceDirectoryListing>
+  sessionIds?: readonly SessionId[]
+  listDirectory?: IWorkspaces['files']['listDirectory']
+} = {}) {
+  const tree = options.tree ?? TREE
+  const listDirectory = vi.fn(options.listDirectory ?? (async (_workspaceId, path) => (
+    tree.get(path) ?? level(path, [])
+  )))
+  const readFile = vi.fn()
+  const workspaces = {
+    list: {
+      getSnapshot: () => ({
+        items: [{ workspaceId: WID, path: '/project', title: 'Project', sessionIds: options.sessionIds ?? [SID] }],
+      }),
+      subscribe: () => () => {},
+    },
+    files: { listDirectory, readFile },
+  } as unknown as IWorkspaces
+  const catalog = new WorkspaceReferenceCatalog(workspaces)
+  const source = (name: string): InputTriggerSource => catalog.sources.find(item => item.name === name)!
+  return {
+    catalog,
+    file: source('workspace-file'),
+    folder: source('workspace-folder'),
+    listDirectory,
+    readFile,
+  }
+}
+
+function pick(source: InputTriggerSource, candidate: InputTriggerCandidate) {
+  return source.onPick({
+    candidate,
+    session,
+    position: 'inline',
+    via: 'menu',
+    span: { start: 0, end: 1, draftRev: 1 },
+  })
+}
+
+describe('WorkspaceReferenceCatalog commands and references', () => {
+  it('offers file and folder commands from partial @ queries and ignores another command prefix', async () => {
+    const b = bench()
+    await expect(b.file.candidates(session, request(''))).resolves.toMatchObject([{ name: 'file' }])
+    await expect(b.folder.candidates(session, request('f'))).resolves.toMatchObject([{ name: 'folder' }])
+    await expect(b.file.candidates(session, request('folder'))).resolves.toEqual([])
+    await expect(b.file.candidates(session, request('folder:src'))).resolves.toEqual([])
+    expect(pick(b.file, (await b.file.candidates(session, request('fi')))[0]!)).toEqual({ text: '@file:' })
+  })
+
+  it('inserts a real chip and uses the same relative path for copy and model serialization', async () => {
+    const b = bench()
+    const candidates = await b.file.candidates(session, request('file:guide'))
+    expect(candidates.map(item => item.name)).toContain('docs/my guide.txt')
+    expect(pick(b.file, candidates.find(item => item.name === 'docs/my guide.txt')!)).toEqual({
+      insert: {
+        source: 'workspace-file',
+        ref: 'docs/my guide.txt',
+        label: '@file:"docs/my guide.txt"',
+        clipboardText: '@file:"docs/my guide.txt"',
+      },
+    })
+    expect(b.file.codec!.clipboardText('src/main.ts')).toBe('@file:src/main.ts')
+    await expect(b.file.codec!.serialize('src/main.ts', new AbortController().signal))
+      .resolves.toBe('@file:src/main.ts')
+    expect(pick(b.file, { name: 'unowned' })).toBeUndefined()
+  })
+
+  it('honors an aborted submit serialization', async () => {
+    const b = bench()
+    const abort = new AbortController()
+    abort.abort(new Error('cancelled submit'))
+    await expect(b.folder.codec!.serialize('src', abort.signal)).rejects.toThrow('cancelled submit')
+  })
+})
+
+describe('WorkspaceReferenceCatalog indexing and fuzzy search', () => {
+  it('recursively indexes paths, filters by kind, and never reads file content', async () => {
+    const b = bench()
+    const files = await b.file.candidates(session, request('FILE:main.ts'))
+    expect(files.map(item => item.name).slice(0, 3)).toEqual([
+      'src/main.ts', 'src/main.tsx', 'docs/main.ts-guide.txt',
+    ])
+    await expect(b.folder.candidates(session, request('folder:components'))).resolves.toMatchObject([
+      { name: 'src/components' },
+    ])
+    expect(b.readFile).not.toHaveBeenCalled()
+  })
+
+  it('uses basename, path containment, then subsequence ranking', async () => {
+    const b = bench()
+    const main = await b.file.candidates(session, request('file:main.ts'))
+    expect(main.map(item => item.name).slice(0, 3)).toEqual([
+      'src/main.ts', 'src/main.tsx', 'docs/main.ts-guide.txt',
+    ])
+    const subsequence = await b.file.candidates(session, request('file:mnp'))
+    expect(subsequence[0]?.name).toBe('src/components/MainPanel.tsx')
+    const pathPrefix = await b.file.candidates(session, request('file:src/ma'))
+    expect(pathPrefix[0]?.name).toBe('src/main.ts')
+    const pathSubsequence = await b.file.candidates(session, request('file:s/c/m'))
+    expect(pathSubsequence[0]?.name).toBe('src/components/MainPanel.tsx')
+    await expect(b.file.candidates(session, request('file:no-match-anywhere'))).resolves.toEqual([])
+  })
+
+  it('skips VCS metadata and scans ordinary source before deferred dependency trees', async () => {
+    const b = bench()
+    await b.file.candidates(session, request('file:dependency'))
+    const paths = b.listDirectory.mock.calls.map(call => call[1])
+    expect(paths).not.toContain('.git')
+    expect(paths.indexOf('node_modules')).toBeGreaterThan(paths.indexOf('src/components'))
+  })
+
+  it('skips an unreadable nested directory but reports an unreadable Workspace root', async () => {
+    const nested = bench({
+      listDirectory: async (_workspaceId, path) => {
+        if (path === 'docs') throw new Error('nested denied')
+        return TREE.get(path) ?? level(path, [])
+      },
+    })
+    const files = await nested.file.candidates(session, request('file:main.ts'))
+    expect(files.map(item => item.name).slice(0, 2)).toEqual(['src/main.ts', 'src/main.tsx'])
+
+    const root = bench({ listDirectory: async () => { throw new Error('root denied') } })
+    await expect(root.file.candidates(session, request('file:any'))).rejects.toThrow('root denied')
+    await expect(root.file.candidates(session, request('file:any'))).rejects.toThrow('root denied')
+    expect(root.listDirectory).toHaveBeenCalledTimes(2)
+
+    const rejectPrimitive = vi.fn<IWorkspaces['files']['listDirectory']>().mockRejectedValue('string failure')
+    const nonError = bench({ listDirectory: rejectPrimitive })
+    await expect(nonError.file.candidates(session, request('file:any'))).rejects.toThrow('string failure')
+  })
+
+  it('returns no paths when the Session has no Workspace', async () => {
+    const b = bench({ sessionIds: [] })
+    await expect(b.file.candidates(session, request(''))).resolves.toEqual([])
+    await expect(b.file.candidates(session, request('file:main'))).resolves.toEqual([])
+    expect(b.listDirectory).not.toHaveBeenCalled()
+  })
+
+  it('shares an in-flight scan across superseded candidate requests', async () => {
+    let release: ((listing: WorkspaceDirectoryListing) => void) | undefined
+    const root = new Promise<WorkspaceDirectoryListing>((resolve) => { release = resolve })
+    const b = bench({
+      listDirectory: async (_workspaceId, path) => path === '.' ? root : level(path, []),
+    })
+    const abort = new AbortController()
+    const first = b.file.candidates(session, request('file:main', abort.signal))
+    abort.abort(new Error('superseded'))
+    await expect(first).rejects.toThrow('superseded')
+    const second = b.file.candidates(session, request('file:main'))
+    release!(level('.', [entry('main.ts', 'file')]))
+    await expect(second).resolves.toMatchObject([{ name: 'main.ts' }])
+    expect(b.listDirectory).toHaveBeenCalledTimes(1)
+  })
+
+  it('rejects an already-cancelled request without starting a scan', async () => {
+    const b = bench()
+    const abort = new AbortController()
+    abort.abort()
+    await expect(b.file.candidates(session, request('file:main', abort.signal))).rejects.toMatchObject({
+      name: 'AbortError',
+    })
+    expect(b.listDirectory).not.toHaveBeenCalled()
+
+    const primitiveReason = { aborted: true, reason: 'cancelled' } as AbortSignal
+    await expect(b.file.candidates(session, request('file:main', primitiveReason))).rejects.toMatchObject({
+      name: 'AbortError',
+      message: 'workspace reference search aborted',
+    })
+  })
+
+  it('aborts the shared scan on catalog disposal', async () => {
+    const b = bench({
+      listDirectory: (_workspaceId, _path, signal) => new Promise((_resolve, reject) => {
+        signal?.addEventListener('abort', () => {
+          reject(signal.reason instanceof Error ? signal.reason : new Error('catalog disposed'))
+        }, { once: true })
+      }),
+    })
+    const pending = b.file.candidates(session, request('file:any'))
+    b.catalog.dispose()
+    await expect(pending).rejects.toMatchObject({ name: 'AbortError' })
+  })
+
+  it('refreshes a settled index when the command prefix is opened again', async () => {
+    const b = bench()
+    await b.file.candidates(session, request('file:main'))
+    const firstScanCalls = b.listDirectory.mock.calls.length
+    await b.file.candidates(session, request('file:'))
+    expect(b.listDirectory.mock.calls.length).toBe(firstScanCalls * 2)
+  })
+
+  it('caps a broad candidate menu and the total indexed path count', async () => {
+    const entries = Array.from({ length: 20_050 }, (_, index) => entry(`file-${index}.ts`, 'file'))
+    const b = bench({ tree: new Map([['.', level('.', entries)]]) })
+    const candidates = await b.file.candidates(session, request('file:'))
+    expect(candidates).toHaveLength(40)
+    expect(candidates.some(item => item.name === 'file-20049.ts')).toBe(false)
+  })
+})
