+import { mkdtempSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { afterEach, describe, expect, it } from 'vitest'
+import { composeEntries, initProfile, loadProfile, PROFILE_TEMPLATES, PROFILES_DIR } from '@deepseek-ai/dsh-app-boot'
+
+let home: string | undefined
+
+afterEach(() => {
+  if (home !== undefined) rmSync(home, { recursive: true, force: true })
+  home = undefined
+})
+
+describe('desktop profile composition', () => {
+  it('layers base, Web roster, and Electron replacements in order', () => {
+    home = mkdtempSync(join(tmpdir(), 'dsh-desktop-profile-'))
+    const bundles = PROFILE_TEMPLATES.desktop
+    expect(bundles).toEqual([
+      '@deepseek-ai/dsh-base',
+      '@deepseek-ai/dsh-web-app',
+      '@deepseek-ai/dsh-electron-app',
+    ])
+    initProfile(join(home, PROFILES_DIR, 'desktop'), bundles!)
+    const anchor = fileURLToPath(new URL('../../../apps/cli/package.json', import.meta.url))
+    const profile = loadProfile('dsh', 'desktop', anchor, home)
+    const warnings: string[] = []
+    const rows = composeEntries(profile.layers.map(layer => layer.patches), message => warnings.push(message))
+    const byId = new Map(rows.map(row => [row.id, row]))
+
+    for (const id of ['web-startup', 'webserver', 'web-runtime', 'client-hmr', 'directory-picker']) {
+      expect(byId.get(id)?.disabled, id).toBe(true)
+    }
+    expect(byId.get('connection')).toMatchObject({
+      inject: [],
+      config: { transport: 'electron', trustedHosts: [] },
+    })
+    expect(byId.get('connection')?.disabled).not.toBe(true)
+    expect(byId.get('desktop-directory-picker-host')?.name)
+      .toBe('@deepseek-ai/dsh-host-directory-picker-native')
+    expect(byId.get('desktop-directory-picker-client')?.name)
+      .toBe('@deepseek-ai/dsh-client-ui-directory-picker-native')
+    expect(byId.has('modules')).toBe(true)
+    expect(byId.has('api-gateway')).toBe(true)
+    expect(warnings).toEqual([])
+  })
+})
