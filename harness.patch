+    content: content.filter((block) => {
+      if (block.type !== 'tool-call') return true
+      const signature = JSON.stringify([block.name, block.arguments])
+      if (!flooded.has(signature)) return true
+      if (retained.has(signature)) return false
+      retained.add(signature)
+      return true
+    }),
