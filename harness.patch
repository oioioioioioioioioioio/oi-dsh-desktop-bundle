+// @vitest-environment jsdom
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { act, cleanup, fireEvent, render, waitFor } from '@testing-library/react'
+import type {
+  DesktopWindowControls, DesktopWindowState,
+} from '../src/DesktopChrome.tsx'
+import { DesktopChrome } from '../src/DesktopChrome.tsx'
+
+class FakeWindowControls implements DesktopWindowControls {
+  readonly minimize = vi.fn()
+  readonly toggleMaximize = vi.fn()
+  readonly close = vi.fn()
+  readonly initial = Promise.withResolvers<DesktopWindowState>()
+  listener: ((state: DesktopWindowState) => void) | undefined
+  readonly getState = vi.fn(() => this.initial.promise)
+  readonly onStateChange = vi.fn((listener: (state: DesktopWindowState) => void) => {
+    this.listener = listener
+    return () => { this.listener = undefined }
+  })
+
+  emit(state: DesktopWindowState): void {
+    this.listener?.(state)
+  }
+}
+
+afterEach(() => {
+  cleanup()
+  delete (globalThis as { dshDesktop?: unknown }).dshDesktop
+})
+
+describe('DesktopChrome', () => {
+  it('leaves the browser shell unchanged without an Electron preload', () => {
+    const view = render(
+      <DesktopChrome title="DeepSeek Harness"><div data-testid="content" /></DesktopChrome>,
+    )
+    expect(view.getByTestId('content')).toBeTruthy()
+    expect(view.queryByRole('button')).toBeNull()
+  })
+
+  it('discovers the preload controls and renders the logo, title, and native actions', async () => {
+    const controls = new FakeWindowControls()
+    ;(globalThis as { dshDesktop?: unknown }).dshDesktop = { windowControls: controls }
+    const view = render(
+      <DesktopChrome title="Session — DeepSeek Harness"><div data-testid="content" /></DesktopChrome>,
+    )
+    controls.initial.resolve({ maximized: false, fullScreen: false })
+    await waitFor(() => { expect(controls.getState).toHaveBeenCalledOnce() })
+
+    expect(view.getByText('Session — DeepSeek Harness')).toBeTruthy()
+    expect(view.container.querySelector('img')?.getAttribute('src')).toBe('/logo.jpg')
+    fireEvent.click(view.getByRole('button', { name: '最小化' }))
+    fireEvent.click(view.getByRole('button', { name: '最大化' }))
+    fireEvent.click(view.getByRole('button', { name: '关闭' }))
+    expect(controls.minimize).toHaveBeenCalledOnce()
+    expect(controls.toggleMaximize).toHaveBeenCalledOnce()
+    expect(controls.close).toHaveBeenCalledOnce()
+  })
+
+  it('uses live native state over a stale initial read and hides chrome in fullscreen', async () => {
+    const controls = new FakeWindowControls()
+    const view = render(
+      <DesktopChrome controls={controls} title="DeepSeek Harness"><div data-testid="content" /></DesktopChrome>,
+    )
+    act(() => { controls.emit({ maximized: true, fullScreen: false }) })
+    expect(view.getByRole('button', { name: '还原' })).toBeTruthy()
+
+    controls.initial.resolve({ maximized: false, fullScreen: false })
+    await act(async () => { await controls.initial.promise })
+    expect(view.getByRole('button', { name: '还原' })).toBeTruthy()
+
+    act(() => { controls.emit({ maximized: true, fullScreen: true }) })
+    expect(view.queryByLabelText('窗口标题栏')).toBeNull()
+    expect(view.getByTestId('content')).toBeTruthy()
+
+    act(() => { controls.emit({ maximized: false, fullScreen: false }) })
+    expect(view.getByRole('button', { name: '最大化' })).toBeTruthy()
+    view.unmount()
+    expect(controls.listener).toBeUndefined()
+  })
+})
