+    if (confirmDiscard(document)) void files.reload(document.id)
+  }
+
+  if (active === undefined) return null
+
+  return (
+    <div className={css.root} data-file-workbench>
+      <div className={css.tabs} role="tablist" aria-label={t('file.tabs')}>
+        <div className={css.tabScroller}>
+          {state.documents.map(document => (
+            <div key={document.id} className={css.tab} data-active={document.id === active.id || undefined}>
+              <button
