@@ -0,0 +1,45 @@
+/** Details-column router between Tool material and the Workspace file workbench. */
+
+import type { DetailsSlotProps } from '../contract/slots.ts'
+import { DetailsPanel } from './DetailsPanel.tsx'
+import { FileWorkbench } from './FileWorkbench.tsx'
+import { ProjectExplorerPanel } from './ProjectExplorer.tsx'
+
+/** Keep both details presentations mounted behind one slot registration. */
+export function DetailsHost({
+  useWorkspaceFiles,
+  files,
+  openWorkspaceFile,
+  openFileExternal,
+  ...details
+}: DetailsSlotProps) {
+  const state = useWorkspaceFiles(snapshot => snapshot)
+  const active = state.documents.find(document => document.id === state.activeId)
+  const selection = details.useStore(snapshot => snapshot.selection)
+  const workspaceId = details.useWorkspaces(snapshot => snapshot.items.find(
+    workspace => workspace.sessionIds.includes(details.sessionId),
+  )?.workspaceId)
+  if (active !== undefined) {
+    return (
+      <FileWorkbench
+        state={state}
+        files={files}
+        openExternal={openFileExternal}
+        closeDetails={details.closeDetails}
+        t={details.t}
+      />
+    )
+  }
+  if (selection === null && workspaceId !== undefined) {
+    return (
+      <ProjectExplorerPanel
+        workspaceId={workspaceId}
+        files={files}
+        openFile={openWorkspaceFile}
+        closeDetails={details.closeDetails}
+        t={details.t}
+      />
+    )
+  }
+  return <DetailsPanel {...details} />
+}
